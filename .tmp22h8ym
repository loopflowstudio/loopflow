ne/launch.rs","rust/loopflow/src/engine/mod.rs","rust/loopflow/src/engine/process.rs","rust/loopflow/src/engine/prompt.rs","rust/loopflow/src/engine/stream.rs","rust/loopflow/src/harness/opencode.rs","rust/loopflow/src/lf/commands/ask.rs","rust/loopflow/src/lf/commands/flow.rs","rust/loopflow/src/lf/commands/install.rs","rust/loopflow/src/lf/commands/mod.rs","rust/loopflow/src/lf/commands/ops/mod.rs","rust/loopflow/src/lf/commands/replay.rs","rust/loopflow/src/lf/commands/run.rs","rust/loopflow/src/lf/commands/runs.rs","rust/loopflow/src/lf/commands/session.rs","rust/loopflow/src/lf/commands/top.rs","rust/loopflow/src/lf/commands/usage.rs","rust/loopflow/src/lf/commands/util.rs","rust/loopflow/src/lf/commands/waves.rs","rust/loopflow/src/lf/commands/work.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/machine_install.rs","rust/loopflow/src/ops/ask.rs","rust/loopflow/src/ops/ask_comments.rs","rust/loopflow/src/ops/human_session.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/src/ops/pm.rs","rust/loopflow/src/ops/pr_landing.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/pm/linear.rs","rust/loopflow/src/provider_account.rs","rust/loopflow/src/provider_auth/mod.rs","rust/loopflow/src/run_record.rs","rust/loopflow/src/store/children.rs","rust/loopflow/src/store/durable.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/native_human_session_runtime__d511c680991f4c3f938a6064d651e86c.sql","rust/loopflow/src/store/migrations/drafts/restore_completed_task_work__f42d7f3e54b84ab8b3a10a89e1d9c6f2.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite/children.rs","rust/loopflow/src/store/sqlite/controller.rs","rust/loopflow/src/store/sqlite/durable.rs","rust/loopflow/tests/config_tests.rs","rust/loopflow/tests/pr_tests.rs","rust/loopflow/tests/session_cli_tests.rs","rust/loopflow/tests/status_tests.rs","rust/loopflow/tests/task_initialization_tests.rs","rust/loopflow/tests/wave_resolution_matrix.rs","scripts/launch-resumable-ux-demo.sh","scripts/loopflow-dev.py","scripts/materialize_rust_tests.py","skills/loopflow/SKILL.md","swift/Loopflow/Models/ActivitySnapshot.swift"]},{"sha":"eecde0b2e66f7a6c4f3cf699b4b8d7780bc01b8f","title":"chat: make wave discord agents responsive and steerable (#1238)","files":["Cargo.lock","README.md","docs/agent-api.md","docs/architecture-reference.md","docs/architecture/codebase.md","docs/architecture/data.md","docs/architecture/homes.md","docs/conducting.md","docs/lf.md","docs/troubleshooting.md","docs/waves.md","rust/loopflow/Cargo.toml","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/chat/turns.rs","rust/loopflow/src/controller/project/mod.rs","rust/loopflow/src/controller/task/mod.rs","rust/loopflow/src/controller/wave/README.md","rust/loopflow/src/controller/wave/channel.rs","rust/loopflow/src/controller/wave/chat_reply.rs","rust/loopflow/src/controller/wave/discord.rs","rust/loopflow/src/controller/wave/journal.rs","rust/loopflow/src/controller/wave/mod.rs","rust/loopflow/src/controller/wave/registry.rs","rust/loopflow/src/controller/wave/relocate.rs","rust/loopflow/src/controller/wave/resident.rs","rust/loopflow/src/controller/wave/runner.rs","rust/loopflow/src/controller/wave/runtime.rs","rust/loopflow/src/controller/wave/server.rs","rust/loopflow/src/controller/wave/wire.rs","rust/loopflow/src/durable.rs","rust/loopflow/src/engine/agent.rs","rust/loopflow/src/engine/builtins.rs","rust/loopflow/src/engine/builtins/LOOPFLOW.md","rust/loopflow/src/engine/builtins/project/flow/project.yaml","rust/loopflow/src/engine/builtins/project/skill/project_clarify.md","rust/loopflow/src/engine/builtins/project/skill/project_mutate.md","rust/loopflow/src/engine/builtins/project/skill/project_operate.md","rust/loopflow/src/engine/builtins/project/skill/project_pursue.md","rust/loopflow/src/engine/builtins/surfaces/chat.md","rust/loopflow/src/engine/builtins/wave/flow/wave.yaml","rust/loopflow/src/engine/builtins/wave/skill/wave_chat.md","rust/loopflow/src/engine/builtins/wave/skill/wave_clarify.md","rust/loopflow/src/engine/builtins/wave/skill/wave_mutate.md","rust/loopflow/src/engine/builtins/wave/skill/wave_operate.md","rust/loopflow/src/engine/builtins/wave/skill/wave_pursue.md","rust/loopflow/src/engine/prompt.rs","rust/loopflow/src/engine/skills.rs","rust/loopflow/src/harness/claude.rs","rust/loopflow/src/harness/claude_mapping.rs","rust/loopflow/src/harness/conformance_tests.rs","rust/loopflow/src/harness/mod.rs","rust/loopflow/src/harness/opencode.rs","rust/loopflow/src/harness/opencode_mapping.rs","rust/loopflow/src/lf/commands/activity.rs","rust/loopflow/src/lf/commands/auth.rs","rust/loopflow/src/lf/commands/fixtures.rs","rust/loopflow/src/lf/commands/install.rs","rust/loopflow/src/lf/commands/list.rs","rust/loopflow/src/lf/commands/mod.rs","rust/loopflow/src/lf/commands/reply.rs","rust/loopflow/src/lf/commands/run.rs","rust/loopflow/src/lf/commands/util.rs","rust/loopflow/src/lf/commands/work.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/lfd/mod.rs","rust/loopflow/src/ops/child.rs","rust/loopflow/src/ops/metrics.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/src/ops/pm.rs","rust/loopflow/src/ops/pr_landing.rs","rust/loopflow/src/ops/project.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/provider_account.rs","rust/loopflow/src/provider_account/lease.rs","rust/loopflow/src/provider_auth/mod.rs","rust/loopflow/src/store/children.rs","rust/loopflow/src/store/durable.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/retire_steers_table__514cf84cd74b1525b507d6d2fb6fdfc1.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/store/sqlite/children.rs","rust/loopflow/src/store/sqlite/ci_incidents.rs","rust/loopflow/src/store/sqlite/durable.rs","rust/loopflow/src/wave_host.rs","rust/loopflow/src/work/project.rs","rust/loopflow/src/work/task/mod.rs","rust/loopflow/src/work/wave/config.rs","rust/loopflow/src/work/wave/context.rs","rust/loopflow/tests/agent_tests.rs","rust/loopflow/tests/auth_tests.rs","rust/loopflow/tests/discovery_tests.rs","rust/loopflow/tests/land_tests.rs","rust/loopflow/tests/lfd_tests.rs","rust/loopflow/tests/status_tests.rs","rust/loopflow/tests/support/mod.rs","rust/loopflow/tests/task_github_cache_tests.rs","rust/loopflow/tests/wave_repository_ownership.rs","rust/loopflow/tests/wave_resolution_tests.rs"]}],"merged_prs":[{"number":1238,"title":"chat: make wave discord agents responsive and steerable","body":"## Evaluate\n\nWith a Discord-backed Wave running:\n\n```bash\ndoppler run -- lf wave <wave>\nlf chat -w <wave> \"what should we start next?\"\n```\n\nObserve that the message receives an immediate pickup reaction, produces one deliberate reply instead of a streamed work transcript, and finishes with a success reaction. Restart the listener and confirm the message is not answered twice.\n\nExercise live Task direction during a running skill:\n\n```bash\nlf task steer <task> \"take the smaller approach\"\nlf task interrupt <task>\n```\n\nThe steer reaches the active provider at its next turn boundary; interrupt ends the current turn so execution restarts with the durable direction.\n\nRun the focused automated coverage:\n\n```bash\ncargo test -p loopflow controller::wave::\ncargo test -p loopflow controller::task::\ncargo test -p loopflow controller::project::\ncargo test -p loopflow harness::\ncargo test -p loopflow store::\n```\n\n## Why it matters\n\nWave chat now behaves like an operator instead of exposing controller machinery: Discord acknowledges promptly, the model sees the durable conversation including its own replies, and only a completed, warranted response reaches the channel. Direction remains useful during long-running work because Task and Project comments can reach live Codex, Claude, and OpenCode sessions without losing durability.\n\n## What changed\n\n- Added one channel model with durable authorship and reply relationships; reading includes the Wave’s own posts, removing consumption queues and duplicate-reply bookkeeping.\n- Added the shared `wave/chat` responder contract and `lf reply`, while collapsing Wave and Project governance into single `operate` turns.\n- Replaced Discord polling with a resumable Gateway websocket, REST cursor catch-up, delivery reconciliation, and pickup/completion reactions.\n- Moved steers into Task and Project event streams, retired the standalone `steers` table, added live `send_current` support across all three harnesses, and made Task interrupts durable.\n- Made temporary SQLite stores hermetic so migration tests cannot race ambient machine state.\n- Hardened install promotion against version-skew re-exec loops and stale placements whose catalog roots no longer exist; documented Doppler as the credential path.\n\n## Risks / Not included\n\n- Discord bindings now require Add Reactions and Message Content permissions.\n- Real-provider Claude and OpenCode steering checks remain opt-in ignored tests; deterministic tests cover the shared controller contract.\n- A dedicated responder process and Discord thread-to-Task mapping remain follow-up work; this change establishes the shared reply boundary on the existing resident.","files":[],"additions":4846,"deletions":1874,"changed_files":111,"merge_commit":"eecde0b2e66f7a6c4f3cf699b4b8d7780bc01b8f"},{"number":1250,"title":"sessions: make human boundaries durable and resumable","body":"## Evaluate\n\n```bash\ncargo test -p loopflow\nswift test --package-path swift\nuv run python scripts/test.py --ui-host\n```\n\nThe Rust and Swift suites exercise Session persistence, CLI contracts, controller playheads, shared DTOs, and desktop projections. On a permissioned macOS host, the UI gate verifies that interactive, Ask, and FlowStep sessions expose only their valid resolution actions.\n\nExercise provider-native resume directly:\n\n```bash\nscripts/launch-resumable-ux-demo.sh codex\nscripts/launch-resumable-ux-demo.sh list\nscripts/launch-resumable-ux-demo.sh open <session-id>\nscripts/launch-resumable-ux-demo.sh complete <session-id>\n```\n\nObserve that provider exit or pane close leaves the Session listed and resumable with its native history. Only Complete removes interactive and Ask sessions; Task FlowSteps require Approve or Iterate.\n\n## Why it matters\n\nReadiness, process exit, and human approval are different facts. Keeping them separate prevents automation from advancing when a provider or terminal disappears, while preserving the exact conversation a person needs to resume after process, app, or machine-control restarts.\n\n## What changed\n\n- Replaced the Ask queue and attention model with one Session projection over interactive Runs, ad-hoc human Asks, and Task human FlowSteps.\n- Added `lf session` commands for listing, opening, readiness, completion, approval, and iteration, with exact provider-client ownership and provider-native resume.\n- Persisted Task Flow positions and simplified Project/Task controllers and storage around durable boundaries, semantic Task conditions, and one active Task branch/PR.\n- Reworked the macOS Sessions surface to consume the same DTO, attach native terminals, keep pane closure non-settling, and show only the actions valid for each Session kind.\n- Bound desktop control to the machine-selected Home and authenticated copied runtime binaries by digest; repository discovery now collapses linked worktrees to their main checkout.\n- Added Work-scoped usage filtering and updated fixtures, migrations, prompts, and architecture documentation to match the new contracts.\n\n## Risks / Not included\n\n- The legacy Ask tables, commands, and attention DTOs are removed rather than supported through a compatibility layer.\n- Settled Task PRs remain as serial delivery history; this establishes the one-active-branch contract without removing historical records.","files":[],"additions":8003,"deletions":8383,"changed_files":168,"merge_commit":"7889d65bc1ac1446da3aacca460a55f1e08b6b0f"}],"decisions":null,"previous_release_notes":"# v0.12.15\n\n<!-- loopflow:release-notes=narrative;gate=safe -->\n\nv0.12.15 makes local execution and release operations recoverable from recorded evidence instead of ambient state. You can promote an unpublished build without disturbing the reliable published Home, compose bounded Runs around tracked Work without handing ownership to a controller, and inspect or replay a Run from its Home-local record. Release tags now attest to an exact candidate that already passed hosted validation and publisher preparation, so a failed candidate can be fixed and retried without consuming the version.\n\n## Try local builds without risking the published Home\n\nLocal promotion now switches the CLI, daemon, and app as one artifact set while preserving the published installation as a fallback. Development data lives in a disposable Home forked from the published Home, and every persisted switch phase can recover after interruption.\n\n- `uv run python scripts/install.py local --use` builds and promotes the local artifact set.\n- Add `--fresh` to fork a new development Home; otherwise Loopflow reuses a compatible one.\n- `uv run python scripts/install.py refresh` returns every surface to the published installation without importing development data.\n- Development builds embed dependency-ordered draft migrations and apply only an exact append-only prefix to the disposable store.\n- Promotion preflight can recover a published candidate's identity even when the release host's live Home is incompatible with that artifact.\n\n## Share tracked Work without controller ownership\n\nWave, Project, and Task records now describe durable Work independently from the automation that may pursue it. Humans, bounded agents, cron jobs, and alternate orchestration can use the same execution and delivery primitives without impersonating or advancing an end-to-end controller.\n\n- `lf task prepare` and `lf project prepare` establish tracked Work without starting controller automation.\n- `--task`, `--project`, and `--wave` bind independent Runs to existing Work while preserving each Run's own provenance.\n- Multiple independent Runs can concern the same Task; Work attribution is no longer a provider writer lease.\n- `lf task restart` checkpoints the worktree and resets controller progress while preserving Task, worktree, and PR identity.\n- Managed Tasks can follow the human-submit path without requiring a live controller, and landing collapses intermediate checkpoints before publishing the verified head.\n\n## Inspect and replay the Run that actually happened\n\nProvider execution now produces a Home-local Run record: an immutable manifest published before spawn, an append-only event stream, and one exclusive terminal receipt. This replaces the SQL-backed Invocation/Turn execution control plane and makes identity evidence and causality rather than a mutation lease.\n\n- `lf runs <id>` reads the Run summary, while `lf runs <id> --events` exposes its recorded events.\n- `lf replay <id>` launches a new child Run through the ordinary harness from the recorded execution contract and preserves the source relationship.\n- Run evidence records the effective prompts, agent and model, stable non-secret account identity, turn cap, browser capability, permission mode, filesystem boundary, provider output, conversation, retries, and provider-authored cumulative usage.\n- Replay resolves the exact recorded account on the selected Home and fails closed when the schema, account, or managed-Run evidence cannot support the launch; it does not record credential bytes, environment values, resume tokens, callbacks, repository contents, or process ownership as replay inputs.\n- `lf trace --events` and `lf doctor` now understand the measured historical usage shapes without accepting unknown or partial records as valid current data.\n- Ended Runs from retired CI controllers remain readable with their unknown trigger JSON preserved byte-for-byte, while unknown nonterminal triggers remain invalid and cannot reserve new Runs.\n\n## Tag only candidates that have already passed\n\nThe release tag is now the attestation, not the starting gun. Loopflow builds from a provisional exact-commit candidate ref, verifies the workflow by branch and head SHA, prepares publication artifacts, and only then pushes the immutable version tag.\n\n- Nightly and release candidates share one credential-free package matrix, with candidate binaries reporting their intended final version before the tag exists.\n- Publisher preparation stores artifacts and receipts under `.lf/releases/`, binding the candidate tag, source commit, workflow run, completed proof stages, and artifact hashes.\n- Publication revalidates the receipt and every artifact before upload, then removes successful candidate state.\n- A failed build leaves the repository untagged and preserves its candidate evidence, so the same version can be retried after a fix merges.\n- Tag pushes no longer trigger release builds; hosted builds use the explicit candidate-dispatch contract, while credentialed signing and publication remain on the maintained publisher host.\n\n## Operational notes\n\n- Work-bound Runs share a worktree but are not file-edit transactions. Give concurrent contributions distinct paths and reconcile them before checkpointing.\n- Replay uses current credentials and current repository contents as live launch inputs even though the execution contract itself is immutable. Exact-account replay refuses rather than silently choosing another identity.\n- Local promotion retains the published fallback and never imports development data during `refresh`; use `--fresh` when a clean fork is required.\n\n## Small changes\n\n- Cron continuity now checks the latest due local-time interval for an exactly matching scheduled receipt. Historical ledger gaps remain visible without permanently blocking `lf doctor` or the telemetry scorecard.\n- Scheduled receipts prove the scheduler fired even when the target failed; manual receipts do not satisfy continuity.\n- Wave memory now retains the release-recovery evidence restored during main reconciliation, and the list Wave starts from its current Linear-backed context.","source_limits":{"context_bytes":131072,"commits":256,"merged_prs":200,"files_per_change":100,"area_scopes":32,"name_bytes":256,"title_bytes":300,"path_bytes":512,"pr_body_bytes":4096,"decisions_bytes":16384,"previous_release_notes_bytes":16384,"release_notes_bytes":61440},"omissions":{"commits":0,"merged_prs":0,"commit_files":81,"pr_files":0,"area_scopes":0,"text_bytes":0,"decisions_bytes":0,"previous_release_notes_bytes":0}}