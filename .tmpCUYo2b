/Views/TaskFilesView.swift","swift/LoopflowMac/Views/TaskWorkspaceView.swift","swift/LoopflowMac/Views/WaveDetailPane.swift","swift/LoopflowMac/Views/WavesView.swift","swift/LoopflowMac/Views/WorkspaceBreadcrumbBar.swift","swift/LoopflowMac/WorkspaceProjection.swift","swift/LoopflowTests/DesktopPerformanceTests.swift","swift/LoopflowTests/RegistryQueryTests.swift","swift/LoopflowTests/SessionChromeProofTests.swift","swift/LoopflowTests/TaskFilesTests.swift","swift/LoopflowTests/TaskMonitorProofTests.swift","swift/LoopflowTests/TaskMonitorTests.swift","swift/LoopflowTests/TaskSessionLaunchProofTests.swift","swift/LoopflowTests/TaskWorkspaceFixture.swift","swift/LoopflowTests/WorkspaceNavigationProofTests.swift","swift/README.md","tests/fixtures/dto/README.md","tests/fixtures/dto/task_files.json","wave/product/MEMORY.md"]},{"sha":"5402d93974dba3b6e94bea1d411951a9dfeb20d9","title":"Reuse the merge queue’s exact CI proof on main (#1336)","files":[".github/workflows/ci.yml","TESTING.md","python/tests/test_ci_proof.py","scripts/check_ci_proof.py"]},{"sha":"7c2f53b9e91564ae0ac37618098bbff065f1af9e","title":"Filter Run ownership before parsing unrelated event histories (#1337)","files":["rust/loopflow/src/lf/commands/runs.rs","rust/loopflow/src/lf/commands/work_catalog.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/run_record.rs"]},{"sha":"c509f68a848c7c4b8b20b7c366d565d00a9dd21d","title":"Keep unrelated worker commits from rebuilding the CLI (#1338)","files":["rust/loopflow/build.rs"]},{"sha":"7e5f32ce607f7ed744c685b2f7639b304455460c","title":"Read PR merge state and queue membership together (#1339)","files":["docs/architecture/delivery.md","rust/loopflow/src/ops/pr.rs","rust/loopflow/src/ops/pr_landing.rs","rust/loopflow/src/ops/release.rs","rust/loopflow/tests/land_tests.rs","rust/loopflow/tests/pr_tests.rs","rust/loopflow/tests/release_tests.rs","rust/loopflow/tests/support/mod.rs","rust/loopflow/tests/task_pr_range_tests.rs"]},{"sha":"21c020035e20a196f71ac03433