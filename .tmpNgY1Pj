{"version":"0.12.8","prev_tag":"v0.12.7","target":"default","tag_prefix":"","area_scope":[],"commits":[{"sha":"3c59a7f68f66ca20a002bd627f4a3c0bfb56fd45","title":"usage: unify live provider accounting (#1166)","files":["README.md","STYLE.md","TESTING.md","docs/architecture.md","docs/conducting.md","docs/lf.md","docs/subscriptions.md","rust/loopflow/src/chat/types.rs","rust/loopflow/src/engine/agent.rs","rust/loopflow/src/engine/builtins/LOOPFLOW.md","rust/loopflow/src/engine/launch.rs","rust/loopflow/src/flowloop/wave.rs","rust/loopflow/src/harness/claude.rs","rust/loopflow/src/harness/claude_mapping.rs","rust/loopflow/src/harness/codex.rs","rust/loopflow/src/harness/conformance_tests.rs","rust/loopflow/src/harness/mod.rs","rust/loopflow/src/harness/opencode.rs","rust/loopflow/src/harness/opencode_mapping.rs","rust/loopflow/src/lf/commands/context.rs","rust/loopflow/src/lf/commands/doctor.rs","rust/loopflow/src/lf/commands/ops/mod.rs","rust/loopflow/src/lf/commands/runs.rs","rust/loopflow/src/lf/commands/top.rs","rust/loopflow/src/lf/commands/usage.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/lib.rs","rust/loopflow/src/project/runner.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/add_turn_usage_samples__c6b6b00eb57a8e1c651937be4ccbf2a1.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/store/sqlite/durable.rs","rust/loopflow/src/task/runner.rs","rust/loopflow/src/trace.rs","rust/loopflow/src/usage.rs","rust/loopflow/src/wave/discord.rs","rust/loopflow/src/wave/journal.rs","rust/loopflow/src/wave/mod.rs","rust/loopflow/src/wave/registry.rs","rust/loopflow/src/wave/runtime.rs","rust/loopflow/src/wave/supervisor.rs","rust/loopflow/src/wave/wire.rs","rust/loopflow/tests/agent_tests.rs","rust/loopflow/tests/context_tests.rs","rust/loopflow/tests/doctor_tests.rs","rust/loopflow/tests/flow_tests.rs","rust/loopflow/tests/land_tests.rs","rust/loopflow/tests/pr_tests.rs","rust/loopflow/te