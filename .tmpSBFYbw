_tests.rs","rust/loopflow/tests/land_tests.rs","rust/loopflow/tests/pr_tests.rs","rust/loopflow/tests/release_lock_tests.rs","rust/loopflow/tests/release_tests.rs","rust/loopflow/tests/scheduled_release_tests.rs","rust/loopflow/tests/support/ambient.rs","rust/loopflow/tests/wave_resolution_matrix.rs","rust/loopflow/tests/worktree_tests.rs","scripts/deploy_website.py","scripts/publish_release.py","scripts/release-loopflow.py","tests/fixtures/dto/release_history.json","wave/infrastructure/MEMORY.md"]},{"sha":"b1f79c5f75fa0f3cde7a3980ecae5db09d8182bd","title":"Choose a New Session skill and capture Tasks without moving existing work (#1418)","files":["rust/loopflow/src/engine/builtins.rs","rust/loopflow/src/engine/builtins/task/skill/capture-tasks.md","rust/loopflow/src/engine/builtins/wave/skill/wave_session.md","swift/Loopflow/Services/RegistryQuery.swift","swift/LoopflowMac/ConversationLaunch.swift","swift/LoopflowMac/PodiumModel.swift","swift/LoopflowMac/Views/SessionSkillPicker.swift","swift/LoopflowMac/Views/SessionsView.swift","swift/LoopflowMac/Views/WorkspaceNavigator.swift","swift/LoopflowMac/WorkspaceProjection.swift","swift/LoopflowTests/TaskCaptureTests.swift","swift/README.md","wave/product/MEMORY.md"]},{"sha":"2115a8ad42aaa3a952d485175a7018e6dd49773a","title":"Clarify published installation and weekly schedule evidence (#1414)","files":["wave/infrastructure/MEMORY.md"]},{"sha":"4bff3b7f7515d4d6344a126ee22c8bbb6c8177d9","title":"Share Claude and Codex conversations between Loopflow and their native CLIs (#1416)","files":["TESTING.md","docs/architecture-reference.md","docs/config.md","docs/lf-reference.md","docs/security.md","docs/subscriptions.md","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/engine/agent.rs","rust/loopflow/src/engine/builtins/ops/skill/pr-review.md","rust/loopflow/src/engine/config.rs","rust/loopflow/src/engine/invocation.rs","rust/loopflow/src/engine/process.rs","rust/loopflow/src/harness/claude.rs","rust/loopflow/src/harness/codex.rs","rust/loopflow/src/harness/codex_connection.rs","rust/loopflow/src/lf/commands/account.rs","rust/loopflow/src/lf/commands/account_status.rs","rust/loopflow/src/lf/commands/flow.rs","rust/loopflow/src/lf/commands/profile.rs","rust/loopflow/src/lf/commands/session.rs","rust/loopflow/src/lf/commands/util.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/ops/flow_session.rs","rust/loopflow/src/ops/human_session.rs","rust/loopflow/src/ops/human_session/provider_conversation.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/provider_account.rs","rust/loopflow/src/provider_account/activation.rs","rust/loopflow/src/provider_account/identity.rs","rust/loopflow/src/provider_account/lease.rs","rust/loopflow/src/provider_auth/mod.rs","rust/loopflow/src/session_record.rs","rust/loopflow/src/session_record/runtime.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/shared_provider_homes.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/store/sqlite/execs.rs","rust/loopflow/src/store/sqlite/session_events.rs","rust/loopflow/src/store/sqlite/sessions.rs","rust/loopflow/src/subscription.rs","rust/loopflow/tests/agent_tests.rs","rust/loopflow/tests/flow_tests.rs","rust/loopflow/tests/session_lifecycle_tests.rs","rust/loopflow/tests/support/ambient.rs","rust/loopflow/tests/support/mod.rs","tests/e2e/claude_shared_home.py","tests/e2e/codex_connect.py","tests/fixtures/dto/auth_routes.json"]}],"merged_prs":[{"number":1396,"title":"build(deps-dev): bump ruff from 0.16.4 to 0.16.9 in the python group","body":"Bumps the python group with 1 update: [ruff](https://github.com/astral-sh/ruff).\n\nUpdates `ruff` from 0.16.4 to 0.16.9\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a href=\"https://github.com/astral-sh/ruff/releases\">ruff's releases</a>.</em></p>\n<blockquote>\n<h2>0.16.9</h2>\n<h2>Release Notes</h2>\n<p>Released on 2026-09-24.</p>\n<h3>Preview features</h3>\n<ul>\n<li>[<code>ruff</code>] Avoid false positives for overloaded division (<code>RUF069</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28309\">#28309</a>)</li>\n</ul>\n<h3>Bug fixes</h3>\n<ul>\n<li>[<code>flake8-bugbear</code>] Avoid false positives for calls with keyword arguments (<code>B009</code>, <code>B010</code>, <code>B043</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28776\">#28776</a>)</li>\n<li>[<code>flake8-tidy-imports</code>] Allow lazy imports to be used in deferred annotations (<code>TID255</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28767\">#28767</a>)</li>\n</ul>\n<h3>Rule changes</h3>\n<ul>\n<li>Update LibCST-based fixes for Python 3.15 (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28616\">#28616</a>)</li>\n<li>[<code>flake8-pyi</code>] Mention stubs in the diagnostic message (<code>PYI002</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28542\">#28542</a>)</li>\n</ul>\n<h3>Documentation</h3>\n<ul>\n<li>Fix horizontal overflow on the rules documentation page (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28699\">#28699</a>)</li>\n<li>Update rules table with category information (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28651\">#28651</a>)</li>\n<li>[<code>flake8-annotations</code>] Clarify that <code>ANN401</code> checks return types in addition to arguments (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28334\">#28334</a>)</li>\n<li>[<code>flake8-bugbear</code>] Document type-checker interaction (<code>B010</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28509\">#28509</a>)</li>\n<li>[<code>flake8-comprehensions</code>] Document <code>map</code>/generator exception behavior (<code>C417</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/27794\">#27794</a>)</li>\n<li>[<code>ruff</code>] Mention related isort settings (<code>RUF022</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28719\">#28719</a>)</li>\n</ul>\n<h3>Contributors</h3>\n<ul>\n<li><a href=\"https://github.com/qinpei-dev\"><code>@​qinpei-dev</code></a></li>\n<li><a href=\"https://github.com/sanjayrohith\"><code>@​sanjayrohith</code></a></li>\n<li><a href=\"https://github.com/ntBre\"><code>@​ntBre</code></a></li>\n<li><a href=\"https://github.com/webdevsamran\"><code>@​webdevsamran</code></a></li>\n<li><a href=\"https://github.com/zaniebot\"><code>@​zaniebot</code></a></li>\n<li><a href=\"https://github.com/ewdurbin\"><code>@​ewdurbin</code></a></li>\n<li><a href=\"https://github.com/MichaReiser\"><code>@​MichaReiser</code></a></li>\n<li><a href=\"https://github.com/spaceone\"><code>@​spaceone</code></a></li>\n<li><a href=\"https://github.com/IbrahimKhan12\"><code>@​IbrahimKhan12</code></a></li>\n<li><a href=\"https://github.com/devtechedge\"><code>@​devtechedge</code></a></li>\n<li><a href=\"https://github.com/GruffElixir\"><code>@​GruffElixir</code></a></li>\n</ul>\n<h2>Install ruff 0.16.9</h2>\n<h3>Install prebuilt binaries via shell script</h3>\n<pre lang=\"sh\"><code>curl --proto '=https' --tlsv1.2 -LsSf https://releases.astral.sh/github/ruff/releases/download/0.16.9/ruff-installer.sh | sh\n</code></pre>\n<!-- raw HTML omitted -->\n</blockquote>\n<p>... (truncated)</p>\n</details>\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a href=\"https://github.com/astral-sh/ruff/blob/main/CHANGELOG.md\">ruff's changelog</a>.</em></p>\n<blockquote>\n<h2>0.16.9</h2>\n<p>Released on 2026-09-24.</p>\n<h3>Preview features</h3>\n<ul>\n<li>[<code>ruff</code>] Avoid false positives for overloaded division (<code>RUF069</code>) (<a href=\"https://redirect.github.com/astral-sh/ruff/pull/28309\">#28309</a>)</li>\n</ul>\n<h3>Bug fixes</h3>\n<ul>\n<li>[<code>flake8-bugbear","files":[],"additions":69,"deletions":69,"changed_files":1,"merge_commit":"2c2a0ae496458842fe15d5e873120c8c0ab8ed8d"},{"number":1397,"title":"build(deps): bump the rust group with 2 updates","body":"Bumps the rust group with 2 updates: [thiserror](https://github.com/dtolnay/thiserror) and [tiktoken-rs](https://github.com/zurawiki/tiktoken-rs).\n\nUpdates `thiserror` from 2.0.20 to 2.0.21\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a href=\"https://github.com/dtolnay/thiserror/releases\">thiserror's releases</a>.</em></p>\n<blockquote>\n<h2>2.0.21</h2>\n<ul>\n<li>Fix parsing of generic unit variants in display expressions (<a href=\"https://redirect.github.com/dtolnay/thiserror/issues/459\">#459</a>)</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/b1827ee06f81a7d7f954e676771e19a97f9f8e3b\"><code>b1827ee</code></a> Release 2.0.21</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/58037b575a2a5543d0d54a49360554325b49f55a\"><code>58037b5</code></a> Merge pull request <a href=\"https://redirect.github.com/dtolnay/thiserror/issues/459\">#459</a> from dtolnay/turbofish</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/f82a0cf8f06c71263c2caa26e759f337d2778153\"><code>f82a0cf</code></a> Keep track of nested turbofish depth</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/72ea49262d6412ccbc08f1696dda8626409e657d\"><code>72ea492</code></a> Raise required compiler to Rust 1.77</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/72eea0d4ddb17ff9fa873aa74469de850021b22e\"><code>72eea0d</code></a> Resolve io_other_error clippy lint in tests</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/07f09a2ec934df58508ce4fa5e7fbf27cca552c2\"><code>07f09a2</code></a> Raise required compiler to Rust 1.74</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/2715388e8cc5787b3643251f7a7a637e89376688\"><code>2715388</code></a> Update ui test suite to nightly-2026-09-22</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/5a306c7d0a8588caaaaa6a7567aeb25c1c10719b\"><code>5a306c7</code></a> Update ui test suite to nightly-2026-09-05</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/ef9383b37d7c96b01e10df35d3e9e313c7b98b5a\"><code>ef9383b</code></a> Update ui test suite to nightly-2026-08-22</li>\n<li><a href=\"https://github.com/dtolnay/thiserror/commit/8336b8407fbfe69177c504cdbc379db20cf6f131\"><code>8336b84</code></a> Update ui tests for version 2.0.20</li>\n<li>See full diff in <a href=\"https://github.com/dtolnay/thiserror/compare/2.0.20...2.0.21\">compare view</a></li>\n</ul>\n</details>\n<br />\n\nUpdates `tiktoken-rs` from 0.12.0 to 0.12.1\n<details>\n<summary>Release notes</summary>\n<p><em>Sourced from <a href=\"https://github.com/zurawiki/tiktoken-rs/releases\">tiktoken-rs's releases</a>.</em></p>\n<blockquote>\n<h2>v0.12.1</h2>\n<p>A maintenance release that refreshes upstream tiktoken and restores compatibility with the declared Rust 1.85 minimum. Existing public function signatures are unchanged.</p>\n<h2>Changes</h2>\n<ul>\n<li>Refresh the vendor snapshot to OpenAI tiktoken 0.14.0 and align regex dependencies. GPT-5 tokenizer lookup follows upstream's family-prefix matching. (<a href=\"https://redirect.github.com/zurawiki/tiktoken-rs/issues/173\">#173</a>)</li>\n<li>Use a 1,050,000-token context-window default for <code>gpt-6*</code> names. This adds context metadata only; GPT-6 tokenizer lookup and token-budget helpers remain unsupported. (<a href=\"https://redirect.github.com/zurawiki/tiktoken-rs/issues/174\">#174</a>)</li>\n<li>Fix Rust 1.85 compilation and the default-feature README doctest; test both default and all features across supported platforms. (<a href=\"https://redirect.github.com/zurawiki/tiktoken-rs/issues/170\">#170</a>)</li>\n<li>Replace <code>lazy_static</code> with the standard library's <code>LazyLock</code>. (<a href=\"https://redirect.github.com/zurawiki/tiktoken-rs/issues/165\">#165</a>)</li>\n<li>Clarify README instructions and remove release-specific wording. (<a href=\"https://redirect.github.com/zurawiki/tiktoken-rs/issues/172\">#172</a>)</li>\n<li>Fail release detection on registry errors and remove inactive upload jobs. (<a href=\"https://redirect.github.com/zurawiki/tikt","files":[],"additions":18,"deletions":30,"changed_files":1,"merge_commit":"af3254515fa8036414e0059c28bdc34e73267419"},{"number":1398,"title":"build(deps): bump tokio-tungstenite from 0.29.0 to 0.30.0","body":"Bumps [tokio-tungstenite](https://github.com/snapview/tokio-tungstenite) from 0.29.0 to 0.30.0.\n<details>\n<summary>Changelog</summary>\n<p><em>Sourced from <a href=\"https://github.com/snapview/tokio-tungstenite/blob/master/CHANGELOG.md\">tokio-tungstenite's changelog</a>.</em></p>\n<blockquote>\n<h1>0.30.0</h1>\n<ul>\n<li>Update <code>tungstenite</code> to <code>0.30.0</code>. See <a href=\"https://github.com/snapview/tungstenite-rs/blob/master/CHANGELOG.md\"><code>tungstenite</code> release</a>.</li>\n</ul>\n</blockquote>\n</details>\n<details>\n<summary>Commits</summary>\n<ul>\n<li><a href=\"https://github.com/snapview/tokio-tungstenite/commit/4994a078037a18a9347b8cf49291a5031d63d9e0\"><code>4994a07</code></a> Bump version</li>\n<li><a href=\"https://github.com/snapview/tokio-tungstenite/commit/753ca72690919485a1aa1f0f69a336b1152fb0ae\"><code>753ca72</code></a> Document cancel safety of reading from WebSocketStream (<a href=\"https://redirect.github.com/snapview/tokio-tungstenite/issues/378\">#378</a>)</li>\n<li><a href=\"https://github.com/snapview/tokio-tungstenite/commit/751d7e2bc26e5de302f4a79907b6949bf00e0043\"><code>751d7e2</code></a> Update version number listed in Readme (<a href=\"https://redirect.github.com/snapview/tokio-tungstenite/issues/375\">#375</a>)</li>\n<li><a href=\"https://github.com/snapview/tokio-tungstenite/commit/57fc3d0276564efaf11efe8c1499b26b44dbe9a4\"><code>57fc3d0</code></a> docs(CHANGELOG.md): fix <code>tungstenite</code> versions (<a href=\"https://redirect.github.com/snapview/tokio-tungstenite/issues/374\">#374</a>)</li>\n<li>See full diff in <a href=\"https://github.com/snapview/tokio-tungstenite/compare/v0.29.0...v0.30.0\">compare view</a></li>\n</ul>\n</details>\n<br />\n\n\n[![Dependabot compatibility score](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=tokio-tungstenite&package-manager=cargo&previous-version=0.29.0&new-version=0.30.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't alter it yourself. You can also trigger a rebase manually by commenting `@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits that have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all of the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop Dependabot creating any more for this major version (unless you reopen the PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop Dependabot creating any more for this minor version (unless you reopen the PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop Dependabot creating any more for this dependency (unless you reopen the PR or upgrade to it yourself)\n\n\n</details>","files":[],"additions":60,"deletions":16,"changed_files":2,"merge_commit":"b7ed4784a6789ef777d6f5f20129828c8c53123e"},{"number":1399,"title":"build(deps): bump dirs from 6.0.0 to 7.0.0","body":"Bumps dirs from 6.0.0 to 7.0.0.\n\n\n[![Dependabot compatibility score](https://dependabot-badges.githubapp.com/badges/compatibility_score?dependency-name=dirs&package-manager=cargo&previous-version=6.0.0&new-version=7.0.0)](https://docs.github.com/en/github/managing-security-vulnerabilities/about-dependabot-security-updates#about-compatibility-scores)\n\nDependabot will resolve any conflicts with this PR as long as you don't alter it yourself. You can also trigger a rebase manually by commenting `@dependabot rebase`.\n\n[//]: # (dependabot-automerge-start)\n[//]: # (dependabot-automerge-end)\n\n---\n\n<details>\n<summary>Dependabot commands and options</summary>\n<br />\n\nYou can trigger Dependabot actions by commenting on this PR:\n- `@dependabot rebase` will rebase this PR\n- `@dependabot recreate` will recreate this PR, overwriting any edits that have been made to it\n- `@dependabot show <dependency name> ignore conditions` will show all of the ignore conditions of the specified dependency\n- `@dependabot ignore this major version` will close this PR and stop Dependabot creating any more for this major version (unless you reopen the PR or upgrade to it yourself)\n- `@dependabot ignore this minor version` will close this PR and stop Dependabot creating any more for this minor version (unless you reopen the PR or upgrade to it yourself)\n- `@dependabot ignore this dependency` will close this PR and stop Dependabot creating any more for this dependency (unless you reopen the PR or upgrade to it yourself)\n\n\n</details>","files":[],"additions":3,"deletions":3,"changed_files":2,"merge_commit":"cd344891b611914adf44eeb53844193d7a987d2c"},{"number":1414,"title":"Clarify published installation and weekly schedule evidence","body":"Outdated refresh requirements and installation diagnoses made it difficult to tell what had been verified on the laptop. This documentation-only PR reconciles the evidence with the current command responsibilities and makes the remaining verification work explicit.\n\n<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [Keep published installation and main checkout updates reliable · LOO-292](https://linear.app/loopflow/issue/LOO-292/keep-published-installation-and-main-checkout-updates-reliable)\n> **PR lifecycle:** Merging PR 2 leaves the Task open for another serial PR.\n<!-- loopflow:task-pr-context:end -->\n\n## What changes\n\n- Clarify that `lf install` updates published machine artifacts, while `lf rebase` owns checkout updates; scheduling defaults to opt-in login plus weekly execution.\n- Record published 0.12.31 preflight, executable hash and app signature checks, alongside operator evidence of repeat installation, repeatable schedule activation and initial launchd success.\n- Mark obsolete publication blockers and the mistaken missing-daemon diagnosis as historical, and preserve lasting decisions in infrastructure Wave memory.\n- Retain outstanding proof for fresh installation and repair, history preservation, installed checkout updates, retained-candidate preflight, natural scheduled or wake execution, and interactive app acceptance. Initial job success does not establish these outcomes.\n\n## Checks\n\n`git diff --check main...HEAD` passes. Historical test results are labeled as such. The recorded validation runner timed out during resource measurement before architecture checks ran; those checks remain deferred to CI.\n\nJack Heart approved the review and explicitly requested autonomous landing on October 4. This documentation PR keeps LOO-292 open for the listed operator proof; no additional installation or schedule outcome is claimed.","files":[],"additions":21,"deletions":0,"changed_files":1,"merge_commit":"2115a8ad42aaa3a952d485175a7018e6dd49773a"},{"number":1416,"title":"Share Claude and Codex conversations between Loopflow and their native CLIs","body":"Loopflow previously kept conversations in separate account homes, making them harder to find and resume from plain Claude or Codex. Conversations now use the provider’s ordinary home by default, with stored account switching and explicit isolation when needed.\n\n## What changes\n\n- Add `lf account <provider> use <email>` to switch the shared login while preserving refreshed or previously unknown credentials. Routing keeps an eligible active account and selects another when needed.\n- Add `--isolate`, `--shared`, and the `isolate` configuration default. Resuming preserves each conversation’s original home mode; existing account-pinned conversations remain isolated.\n- Accept native conversation IDs in `lf session` commands and import previously untracked conversations when connecting.\n- Close owned Codex engines on driver exit while preserving saved history, live takeovers, and unrelated conversations. Retry headless turns interrupted by a shared account switch.\n- Forward SSH credentials without writing logins to the target’s disk; Codex receives its token through the engine protocol.\n- Refocus generated PR reviews on behavior, data models, and APIs.\n\n## Limitations\n\nSwitching accounts changes the login used by plain Claude and Codex too. Running Codex engines retain their original login until restarted; an in-flight turn may fail once, with automatic recovery for headless runs. Shared Codex switching requires file-based credential storage. Forwarded Codex login uses an experimental protocol and requires Loopflow’s engine.\n\n## Checks\n\nAdds coverage for credential preservation, shared and isolated routing, native conversation IDs, and engine ownership, plus provider fixtures using synthetic credentials and local endpoints. Tests were not run while preparing this description.\n\n## Try it\n\nSuggested walkthrough, not performed for this description: start a conversation with `lf -m codex : \"say hi\"`, finish it, then run `codex resume`. The conversation should appear in Codex’s normal history. Switch to another stored login with `lf account codex use <email>` and inspect `lf account route`; the new account should be active while the saved conversation remains available.","files":[],"additions":3968,"deletions":436,"changed_files":49,"merge_commit":"4bff3b7f7515d4d6344a126ee22c8bbb6c8177d9"},{"number":1418,"title":"Choose a New Session skill and capture Tasks without moving existing work","body":"Desktop had no dedicated entry point for turning ideas into Tasks while keeping existing work in place. New Session now launches a chosen skill, defaults to `capture-tasks`, and remembers the choice per repository.\n\n<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [Capture new Tasks from Desktop conversations · LOO-368](https://linear.app/loopflow/issue/LOO-368/capture-new-tasks-from-desktop-conversations)\n> **PR lifecycle:** Merging PR 1 leaves the Task open for another serial PR.\n<!-- loopflow:task-pr-context:end -->\n\n## What changes\n\n- Add a searchable skill picker beside New Session, using repository-local discovery. Choosing a skill updates the next launch without starting it.\n- Launch from the repository sidebar or a Wave’s context menu. A selected Task supplies its parent Wave; the new Session opens in the repository checkout while preserving Task selection and existing terminal layouts.\n- Add `capture-tasks` guidance for exploring ideas, resolving ownership across Waves and repositories, and filing self-contained Tasks without starting workers or binding the capture conversation. Existing Wave conversations reuse this guidance.\n- Preserve successful filings and reconcile uncertain writes before retrying identical input in the destination repository.\n\n## Checks\n\nRecorded branch checks include six passing TaskCaptureTests after integration with main, covering discovery, remembered selection, launch scope, layout preservation, and helper-resolution failures. Earlier builtin tests, navigation tests, Swift build, formatting, and Clippy also passed. The October 4 synced build/sign/open and all six TaskCaptureTests also passed.\n\nNative picker interaction, live provider continuation, draft preservation, and cross-repository filing remain unverified. The configured CLI must include both `capture-tasks` and explicit skill launch support; an earlier demo showed that building the app alone did not supply the required runtime.\n\nJack Heart approved the demo on October 4 and explicitly requested landing. Individual scenario results above remain unverified; approval records the review decision without inventing those observations.\n\n## Try it\n\nSuggested walkthrough, not yet verified end to end: with a Task selected and existing terminals open, choose `capture-tasks` beside New Session, then click New Session. A repository conversation should open with the Task’s parent Wave as context, retaining the existing panes and Task selection. Describe an idea, capture its Tasks, then continue with another idea in the same conversation.","files":[],"additions":596,"deletions":36,"changed_files":13,"merge_commit":"b1f79c5f75fa0f3cde7a3980ecae5db09d8182bd"},{"number":1419,"title":"Track scheduled releases through verified publication and interruption recovery","body":"A successful cron exit previously could not show whether a release reached users or what happened to missed firings. This PR connects each scheduled release opportunity to its execution, verification and product outcome, preserving unfinished candidates and failure evidence through retries.\n\n<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [Account for scheduled release opportunities and settle actual release outcomes · LOO-285](https://linear.app/loopflow/issue/LOO-285/account-for-scheduled-release-opportunities-and-settle-actual-release)\n> **PR lifecycle:** Merging PR 1 leaves the Task open for another serial PR.\n<!-- loopflow:task-pr-context:end -->\n\n## What changes\n\n- Add `lf release history` to distinguish verified publication, verified no-change, deferred work and failures, with repair ownership recorded through `lf cron disposition`.\n- Catch up outstanding due times with one execution per wake. Preserve original timing, candidate ownership and operator interventions; collapsed misses cannot count as additional successful releases.\n- Continue unfinished candidates across schedule replacements on the same Home. Home changes retain unresolved work for repair without transferring execution authority.\n- Retry missing or failed current telemetry once per wake. Interrupted checks require process and lock evidence before recovery; bounded waits defer release without killing surviving checks or inventing results.\n- Verify the exact candidate and public artifacts before settlement. Reconcile missing publication stages from retained artifacts, require public read-back and installer smoke, and preserve newer releases and conflicting immutable assets.\n- Carry release locks and checkout leases through Git, PR, hooks, CI repair and publisher children so controller death cannot permit overlapping publication or premature checkout removal.\n\n## Checks\n\nPassed: 67 release integration tests, 46 focused cron tests, 30 publisher tests, process tests (9 passed; isolated tmux test ignored), formatting and all-target Clippy. All 11 scheduled-release scenarios passed. Interruption/lock coverage passed across 14 suite cases plus the repaired auto-merge scenario run separately; simulated providers do not establish production release success.\n\nJack Heart waived the interactive demo and requested landing. Installed acceptance, public artifact/installer proof and two distinct automatic executions with at least one publication remain follow-up work; this PR does not request Task completion.\n\nReview repairs preserve main's explicit detached-child cwd and update stale fixtures to use current PR observations, explicit missing-release responses, and published source commits.\n\n## Try it\n\nSuggested walkthrough after installation: run `lf release history --wave infrastructure --days 35 --json`. Inspect an opportunity's original due time, linked attempts, verification and outcome. Missed dues covered by one execution should retain their identities while contributing only one settlement; unresolved failures should remain visible after recovery.","files":[],"additions":11163,"deletions":708,"changed_files":48,"merge_commit":"25dbcde69e4cad5fe1f04aee488fc562aa4e958e"},{"number":1421,"title":"Show unfinished interactive Sessions in ordinary navigation","body":"Background agent conversations cluttered Task navigation. Ordinary Desktop and CLI Session lists now show unfinished interactive conversations and current authored reviews, with matching navigation counts.\n\n<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [Show only unfinished interactive Sessions in Task navigation · LOO-372](https://linear.app/loopflow/issue/LOO-372/show-only-unfinished-interactive-sessions-in-task-navigation)\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## What changes\n\n- Desktop uses the shared interactive default; `--needs-me` narrows the selected mode.\n- Filtered absence preserves selection, prepared commands, drafts and retained native surfaces. Explicit completion remains separate from a finished turn.\n- Show headless Sessions and `lf session list --interactive all --history` retain full inspection. Task association and review authority are unchanged.\n\n## Checks\n\nThe Desktop build and 47 focused headless tests passed after compression; an earlier broader run passed 92. API inventory and review-completion/resume integration tests passed, along with 12 Session-event tests, formatting and all-target Clippy. Gate reused unchanged-code receipts; architecture and Swift boundary checks passed. CI owns the full matrix.\n\nProvider review coverage uses a stand-in. These checks do not establish configured provider input, native visual acceptance, sustained use or latency improvements. Direct-opening and performance work remain separate in LOO-371 and LOO-304.\n\n## Try it\n\nOpen a Task containing interactive and background conversations: its ordinary Session list and counts should include only unfinished interactive participation. Enable Show headless Sessions to inspect background work. This is a suggested walkthrough; headless regressions cover the behavior.","files":[],"additions":218,"deletions":112,"changed_files":16,"merge_commit":"4cb891ee8d1f31ca99b029a55806df252e24eb2a"},{"number":1422,"title":"Recover retained PR landings and start workers after checkout removal","body":"Obsolete Home supervision could prevent pending PR landings from loading, while a tmux server left in a deleted checkout could prevent detached workers from starting. This PR preserves retained deliveries through migration and explicitly starts workers in their requested checkout.\n\n## What changes\n\n- Archive retired Home supervisor identity, PID, heartbeat and generation on each landing; advance the generation and clear active supervision while preserving delivery intent, failures, CI state and terminal history.\n- Reject stale supervisor writes and prevent older executables from acquiring fresh Home claims. Existing local supervision remains intact.\n- Set the tmux client’s working directory and enter the shell-quoted checkout inside the detached child before execution. Spawn errors include the requested directory.\n- Curate infrastructure memory and preserve release recovery evidence and historical decisions through Git links.\n\n## Checks\n\nRecorded branch evidence reports passing focused landing and process tests, including migration/read/reconciliation coverage and an isolated tmux test with a deleted server directory. All-target Clippy and the migration catalog check also passed. These checks were not rerun while preparing this description.\n\nThe reconciliation regression uses simulated provider observations. Installed acceptance still requires a published patch; the separately recovered v0.13.0 release predates these fixes. The tmux reproduction establishes the deleted-directory defect, but does not establish the cause of every reported worker timeout.","files":[],"additions":652,"deletions":917,"changed_files":6,"merge_commit":"52ab4a4a5cf1ec3c24b019d5cee3a1c782a30d9b"},{"number":1423,"title":"Enqueue passing Dependabot updates with a dedicated merge token","body":"Dependabot PRs enabled auto-merge but never entered the required merge queue because the workflow used GITHUB_TOKEN. Use the dedicated repository token, retry after successful CI, and explicitly enqueue the unchanged head when queue membership is absent. Keep weekly grouping and all required checks. The secret is installed, and the token successfully enqueued the four existing updates. YAML parsing, shell syntax, and whitespace checks passed; hosted CI verifies the published workflow.","files":[],"additions":42,"deletions":3,"changed_files":2,"merge_commit":"2d0d5cb91ac4bf406e941f0991b8ee974b83ebd8"},{"number":1424,"title":"Prevent Session dispatch deadlocks and confirm Linear writes without Wave sweeps","body":"A stalled Codex dispatch could hold SQLite’s writer transaction while the current-thread event loop tried to record history through the same connection mutex. The event loop also owned the dispatch timeout, so one launch could freeze the shared Home. Native dispatch now uses a Session-scoped OS lock shared with driver claim, release, and exit; SQLite is released before provider I/O. Both Codex dispatch paths and OpenCode use this boundary, preserving stale-driver rejection without blocking unrelated database writes.\n\nETU-89 exposed a separate failure: Linear committed issue creation, then a five-second refresh of the entire Wave failed and prevented local preparation. Creation and edit/completion now confirm the exact issue, reconcile its Project association, and retain duplicate-safe retries. Issue confirmation does not claim fresh observation of the whole Wave.\n\nValidation: 31 affected Rust tests; current-thread regression with a real backpressured WebSocket, SQLite history, independent writer, driver transfer, and an external process watchdog; stateful Linear creation/edit/confirmation recovery tests; cargo fmt, cargo clippy --all-targets -- -D warnings, and architecture checks.\n\nReview preserved driver exclusion on every ownership change and exact Project reconciliation. Lock acquisition uses a bounded OS-clock wait; existing provider transport deadlines remain in force. Existing running binaries retain their old behavior until upgraded. No live-store migration or issue recreation is involved.\n","files":[],"additions":349,"deletions":48,"changed_files":9,"merge_commit":"cb4dd53c94866c7f6e30736977e29e800e9e4c67"}],"decisions":null,"previous_release_notes":"# v0.13.0\n\n<!-- loopflow:release-notes=narrative;gate=safe -->\n\nv0.13.0 brings the completed 0.12 cycle together around keeping work intact through planning changes, review, recovery, and delivery. Conversations and Flows resume from durable Session records, Desktop brings Tasks and their files beside the conversation, and publication failures preserve the work needed to continue. These notes cover progress since v0.12.0, including features already delivered in patches.\n\n## Continue work without reconstructing it\n\nTasks can continue through review and revision using their saved Flow, while durable Session records bring conversation identity, command outcomes, and Flow progress together. Recovery increasingly preserves the existing work instead of requiring another launch to rebuild its context.\n\n- Resume conversations without injecting a new participant-update prompt.\n- Keep a Task’s selected agent and retain account choices across Flow resumes; stalled work is more visible.\n- Route Task direction through Linear comments and keep routine agent progress out of that steering channel.\n- Inspect Linear Tasks before starting work and adopt existing branches.\n- Finish or cancel Tasks with coordinated PR and branch cleanup.\n\n## Keep the conversation and its work together\n\nThe Mac workspace evolved from separate activity and Session surfaces into one repository → Wave → Task → Session outline. Navigation, Flow inspection, and file editing now support working from the conversation itself.\n\n- Find work with ⌘K and Task links.\n- Inspect Task Flows, Monitor, comments, and named Sessions in the shared workspace.\n- Read and edit Task files beside the conversation.\n- Preserve live terminals while navigating, with shell command blocks for terminal work.\n- Inspect composed Flow templates in a folded preview instead of opening every step at once.\n\n## Change plans and preserve direction\n\nResumable chapters replace project selection, with chapter review and plan-start skills supporting explicit planning boundaries. Later changes simplify Wave operation: resident controllers give way to bounded Task workers, and the resident Wave service and chat surfaces are removed.\n\n- Review chapter evidence and reset plans through dedicated skills.\n- Keep chapter sweeps and planning refresh working around other Teams’ Projects.\n- Consolidate planning commands and delete Linear Tasks through `lf`.\n- Realign plans and code before publishing Task work, and preserve useful learnings in Wave memory.\n- Use the manual S1–S5 operation skills for Wave coordination and governance.\n\n## Deliver without losing the branch or PR\n\nDelivery recovery now retains more of the identity and evidence needed to continue after failure. Integration also shifts toward preserving authored history, while queued PRs keep their existing heads and CI progress.\n\n- Merge Task branch updates without rewriting authored history.\n- Retain Task PR identity through publication failures and preserve published descriptions during final preparation.\n- Recover blocked landing operations on the same commit while exposing the repair agent’s concrete blocker.\n- Continue watching queued PRs without redundant rebase recovery, and preserve CI while armed PRs await queue entry.\n- Reuse the merge queue’s exact CI proof on main.\n\n## Spend less time waiting and diagnosing launches\n\nThe cycle reduces repeated verification work and makes launch inputs and account state easier to inspect. Desktop acceptance checks run headlessly, with acceptance consolidated at gate.\n\n- Discover commands, skills, and Flows without launching them.\n- Inspect and configure context budgets before launching agents.\n- Use an installed coding agent for unconfigured runs, replacing the earlier unconditional Codex default.\n- Unify account authentication, remember browser profiles, refresh account status, and keep managed Codex accounts tied to the intended login.\n- Improve prompt-cache reuse and expose cache hit rates alongside retained usage evidence.\n- Reuse Rust, Swift, and Xcode build work in CI; reduce repeated migration bookkeeping and bound busy cache cleanup.\n\n## Operational notes\n\nUpgrade and release recovery receive corresponding safeguards. Branch builds use private data, installed Tasks stay on their owning runtime, and saved Session launches remain tied to their original installation.\n\n- Failed install switches fall back to the prior installation. Release downloads are pinned, and the legacy refresh entry point remains available for older installed CLIs.\n- Installation and machine commands work independently of a repository checkout.\n- Minor releases pair with a closing patch and summarize the completed cycle’s product snapshot.\n- Release recovery handles same-tag publisher worktrees and withdrawn release PRs. Scheduled release CI failures reach the landing repair supervisor, and cron retains failure outcomes.\n- macOS release checks verify that app resources are self-contained.\n\n## Small changes\n\n- Terminal catalog output stays aligned.\n- Failed searches no longer falsely block Task handoff, and saved plans avoid activating unrelated skills.\n- Requests and saved artifacts preserve people’s names.\n- Recent execution queries avoid parsing unrelated historical events.\n- CI job logs record CPU and memory use.","source_limits":{"context_bytes":131072,"commits":256,"merged_prs":200,"files_per_change":100,"area_scopes":32,"name_bytes":256,"title_bytes":300,"path_bytes":512,"pr_body_bytes":4096,"decisions_bytes":16384,"previous_release_notes_bytes":16384,"release_notes_bytes":61440},"omissions":{"commits":0,"merged_prs":0,"commit_files":0,"pr_files":0,"area_scopes":0,"text_bytes":12216,"decisions_bytes":0,"previous_release_notes_bytes":0}}