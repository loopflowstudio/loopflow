{"version":"0.13.1","prev_tag":"v0.13.0","target":"default","tag_prefix":"","area_scope":[],"commits":[{"sha":"4cb891ee8d1f31ca99b029a55806df252e24eb2a","title":"Show unfinished interactive Sessions in ordinary navigation (#1421)","files":["docs/lf.md","rust/loopflow/src/lf/commands/session.rs","rust/loopflow/src/store/sqlite/session_events.rs","rust/loopflow/tests/session_lifecycle_tests.rs","swift/LoopflowMac/PodiumModel.swift","swift/LoopflowMac/Views/SessionsView.swift","swift/LoopflowMac/Views/WorkSurfaceView.swift","swift/LoopflowMac/Views/WorkspaceBreadcrumbBar.swift","swift/LoopflowMac/Views/WorkspaceNavigator.swift","swift/LoopflowMac/Views/WorkspacePalette.swift","swift/LoopflowTests/PodiumModelTests.swift","swift/LoopflowTests/SessionControlsTests.swift","swift/LoopflowTests/SessionsStoreTests.swift","swift/LoopflowTests/WorkspaceNavigationTests.swift","swift/README.md","wave/product/MEMORY.md"]},{"sha":"52ab4a4a5cf1ec3c24b019d5cee3a1c782a30d9b","title":"Recover retained PR landings and start workers after checkout removal (#1422)","files":["rust/loopflow/src/engine/process.rs","rust/loopflow/src/store/MIGRATIONS.md","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/retire_home_landing_supervisors.sql","wave/infrastructure/MEMORY.md","wave/infrastructure/release/MEMORY.md"]},{"sha":"2c2a0ae496458842fe15d5e873120c8c0ab8ed8d","title":"build(deps-dev): bump ruff from 0.16.4 to 0.16.9 in the python group (#1396)","files":["uv.lock"]},{"sha":"af3254515fa8036414e0059c28bdc34e73267419","title":"build(deps): bump the rust group with 2 updates (#1397)","files":["Cargo.lock"]},{"sha":"b7ed4784a6789ef777d6f5f20129828c8c53123e","title":"build(deps): bump tokio-tungstenite from 0.29.0 to 0.30.0 (#1398)","files":["Cargo.lock","rust/loopflow/Cargo.toml"]},{"sha":"cd344891b611914adf44eeb53844193d7a987d2c","title":"build(deps): bump dirs from 6.0.0 to 7.0.0 (#1399)","files":["Cargo.lock","rust/loopflow/Cargo.toml"]},{"sha":"2d0d5cb91ac4bf4