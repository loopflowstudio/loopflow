pflow/src/ops/flow.rs","rust/loopflow/src/ops/git_operation.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/src/ops/pm.rs","rust/loopflow/src/ops/project.rs","rust/loopflow/src/ops/release.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/project/mod.rs","rust/loopflow/src/project/runner.rs","rust/loopflow/src/promotion_lock.rs","rust/loopflow/src/provider_account.rs","rust/loopflow/src/provider_account/recovery.rs","rust/loopflow/src/replay.rs","rust/loopflow/src/run_record.rs","rust/loopflow/src/store/children.rs","rust/loopflow/src/store/durable.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/generic_ask_run_claim__3b5b19a2f8454d3ba5163bfa0a5d17d1.sql","rust/loopflow/src/store/migrations/drafts/obsolete_sql_lifecycle__3a901dfdabc607b3d062fb1466831150.sql","rust/loopflow/src/store/migrations/drafts/opaque_steer_run_provenance__fe43b04cca774a8cb13b1a57813d4e34.sql","rust/loopflow/src/store/migrations/drafts/replay_contracts__3cf7cc7e3d8c4d7ea92cb65e8848aaf6.sql","rust/loopflow/src/store/migrations/drafts/stable_work_state__7c4e2d189f6a4b4a8c5d3e1f0a2b6c8d.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/store/sqlite/children.rs","rust/loopflow/src/store/sqlite/ci_incidents.rs","rust/loopflow/src/store/sqlite/durable.rs","rust/loopflow/src/task/actions.rs"]},{"sha":"a72c6c7ff1a36c82a56d113f5adf9b73070fba9f","title":"wave: reconcile durable main context (#1245)","files":["wave/infrastructure/MEMORY.md","wave/list/GOAL.md","wave/list/MEMORY.md"]},{"sha":"fa0186c4d85c863e6c70e0e5c85adec921c43b93","title":"architecture: separate tracked work from controller automation (#1236)","files":["README.md","docs/agent-api.md","docs/architecture-reference.md","docs/architecture.html","docs/architecture.md","docs/architecture/codebase.md","docs/architecture/data.md","docs/architecture/delivery.md","docs/architecture/execution.md","docs/architecture/homes.md","docs/architecture/planning.md","docs/conducting.md","docs/getting-started.md","docs/lf.md","docs/security.md","docs/waves.md","python/tests/test_architecture.py","rust/loopflow/benches/wave_stream.rs","rust/loopflow/src/bin/lf-prompt.rs","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/chat/turns.rs","rust/loopflow/src/child.rs","rust/loopflow/src/controller/mod.rs","rust/loopflow/src/controller/project/mod.rs","rust/loopflow/src/controller/project/state.rs","rust/loopflow/src/controller/runner.rs","rust/loopflow/src/controller/store.rs","rust/loopflow/src/controller/task/mod.rs","rust/loopflow/src/controller/task/state.rs","rust/loopflow/src/controller/wave/README.md","rust/loopflow/src/controller/wave/chat.rs","rust/loopflow/src/controller/wave/discord.rs","rust/loopflow/src/controller/wave/journal.rs","rust/loopflow/src/controller/wave/metrics.rs","rust/loopflow/src/controller/wave/mod.rs","rust/loopflow/src/controller/wave/placement.rs","rust/loopflow/src/controller/wave/playhead.rs","rust/loopflow/src/controller/wave/registry.rs","rust/loopflow/src/controller/wave/relocate.rs","rust/loopflow/src/controller/wave/resident.rs","rust/loopflow/src/controller/wave/runner.rs","rust/loopflow/src/controller/wave/runtime.rs","rust/loopflow/src/controller/wave/server.rs","rust/loopflow/src/controller/wave/state.rs","rust/loopflow/src/controller/wave/subscription.rs","rust/loopflow/src/controller/wave/supervisor.rs","rust/loopflow/src/controller/wave/wire.rs","rust/loopflow/src/durable.rs","rust/loopflow/src/engine/agent.rs","rust/loopflow/src/engine/builtins/LOOPFLOW.md","rust/loopflow/src/engine/builtins/ops/skill/pr-message.md","rust/loopflow/src/engine/builtins/ops/skill/pr-submit.md","rust/loopflow/src/engine/builtins/project/skill/project_clarify.md","rust/loopflow/src/engine/builtins/task/skill/compress.md","rust/loopflow/src/engine/builtins/task/skill/design.md","rust/loopflow/src/engine/builtins/task/skill/gate.md","rust/loopflow/src/engine/builtins/task/skill/implement.md","rust/loopflow/src/engine/builtins/task/skill/kickoff.md","rust/loopflow/src/engine/builtins/task/skill/research.md","rust/loopflow/src/engine/builtins/task/skill/review-design.md","rust/loopflow/src/engine/builtins/task/skill/review-slice.md","rust/loopflow/src/engine/builtins/task/skill/task_clarify.md","rust/loopflow/src/engine/builtins/task/skill/task_pursue.md","rust/loopflow/src/engine/launch.rs","rust/loopflow/src/engine/machine.rs","rust/loopflow/src/engine/mod.rs","rust/loopflow/src/engine/process.rs","rust/loopflow/src/engine/prompt.rs","rust/loopflow/src/engine/repo.rs","rust/loopflow/src/engine/wave_config.rs","rust/loopflow/src/engine/wave_context.rs","rust/loopflow/src/flowloop/README.md","rust/loopflow/src/flowloop/mod.rs","rust/loopflow/src/flowloop/wave.rs","rust/loopflow/src/harness/mod.rs","rust/loopflow/src/journal/mod.rs","rust/loopflow/src/lf/commands/activity.rs","rust/loopflow/src/lf/commands/chat.rs","rust/loopflow/src/lf/commands/fixtures.rs","rust/loopflow/src/lf/commands/home.rs","rust/loopflow/src/lf/commands/install.rs","rust/loopflow/src/lf/commands/ops/mod.rs","rust/loopflow/src/lf/commands/run.rs","rust/loopflow/src/lf/commands/runs.rs","rust/loopflow/src/lf/commands/ssh.rs","rust/loopflow/src/lf/commands/thread.rs","rust/loopflow/src/lf/commands/usage.rs","rust/loopflow/src/lf/commands/util.rs","rust/loopflow/src/lf/commands/wave_intent.rs","rust/loopflow/src/lf/commands/waves.rs","rust/loopflow/src/lf/commands/work.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/lfd/mod.rs","rust/loopflow/src/lib.rs","rust/loopflow/src/ops/ask.rs","rust/loopflow/src/ops/ask_comments.rs","rust/loopflow/src/ops/child.rs","rust/loopflow/src/ops/commit.rs","rust/loopflow/src/ops/flow.rs","rust/loopflow/src/ops/git_operation.rs"]},{"sha":"696082a9b1817f192aadfe002ef2252fbc437cb6","title":"release: decouple artifact identity from Home compatibility (#1247)","files":["python/tests/test_release_publisher.py","scripts/publish_release.py"]},{"sha":"b2edd7f5dde31eaa8b1130ebb79b229049ac6ab3","title":"LOO-241: Make ledger continuity failures match scheduled obligations (#1248)","files":["docs/lf.md","rust/loopflow/src/lf/commands/doctor.rs","rust/loopflow/src/ops/cron.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/tests/doctor_tests.rs","wave/infrastructure/MEMORY.md"]},{"sha":"ee302c4fea7f3ad9b796c00fb148a5d31f3587c5","title":"release: prove exact candidates before tagging (#1249)","files":[".github/workflows/auto-tag.yml",".github/workflows/nightly-packages.yml",".github/workflows/package-build.yml",".github/workflows/release.yml",".gitignore","docs/architecture-reference.md","docs/architecture.html","docs/architecture.md","docs/config.md","docs/lf.md","python/tests/test_release_automation.py","python/tests/test_release_publisher.py","rust/loopflow/build.rs","rust/loopflow/src/engine/builtins/ops/skill/release-run.md","rust/loopflow/src/ops/release.rs","rust/loopflow/tests/release_tests.rs","scripts/publish_release.py"]}],"merged_prs":[{"number":1229,"title":"Install unpublished local builds through the promotion path — install: safely promote unpublished local builds","body":"Linear Task: [LOO-226](https://linear.app/loopflow/issue/LOO-226/install-local-builds-without-destroying-live-work)\n\n## Usage\n\n```bash\nuv run python scripts/install.py local --use\nuv run python scripts/install.py local --use --fresh\nuv run python scripts/install.py refresh\n```\n\n## Summary\n\nLocal builds can now exercise the installed `lf`, `lfd`, and Loopflow.app surfaces without risking the reliable published Home. Promotion retains the published fallback, forks its data into a disposable development Home, and switches the complete local artifact set through one crash-recoverable drain and relaunch transaction. Refresh returns every surface to the published installation without importing development data.\n\n## Changes\n\n- Added machine-scoped install state and entry gates that bind processes to an exact artifact set and store\n- Made CLI, daemon, keeper, app, and active Work transitions recoverable from every persisted switch phase\n- Embedded dependency-ordered draft migrations in development builds and applied only exact append-only prefixes to disposable stores\n- Reused compatible development Homes by default, with `--fresh` available to fork published data again\n- Added end-to-end coverage for promotion, rollback, artifact authorization, Home reuse, and interrupted-switch recovery","files":[],"additions":9737,"deletions":272,"changed_files":32,"merge_commit":"49b3b403dc8ef6d46ec02390c26b6f82835d04fc"},{"number":1235,"title":"Read historical CI-incident Runs during local promotion — runs: read historical CI incident triggers","body":"Linear Task: [LOO-262](https://linear.app/loopflow/issue/LOO-262/read-historical-ci-incident-runs-during-local-promotion)\n\n## Usage\n\n```bash\ncargo test -p loopflow ended_run_reads_unknown_trigger_as_byte_exact_historical_evidence\ncargo test -p loopflow installed_development_promotion_reads_arbitrary_historical_run_triggers\n```\n\n## Summary\n\nAllows ended Runs from retired CI controllers to remain readable when their persisted trigger kind is no longer recognized. Unknown triggers are retained as opaque historical evidence with their original JSON unchanged, so development promotion and incident review can consume old Run records without weakening validation for current data.\n\n## Changes\n\n- Parse unknown trigger kinds as historical evidence only for ended Runs\n- Preserve historical trigger JSON byte-for-byte\n- Keep malformed current triggers and unknown nonterminal triggers invalid\n- Validate persisted Run triggers with their Run state during migrations\n- Prevent historical evidence from being used to reserve new Runs","files":[],"additions":295,"deletions":9,"changed_files":3,"merge_commit":"a4c73a4c7cc317f9d75a12f583d9bbb1aaee856f"},{"number":1236,"title":"architecture: separate tracked work from controller automation","body":"## Evaluate\n\n```bash\ncargo test -p loopflow controller_free_task_supports_multiple_independent_bindings\ncargo test -p loopflow task_work_and_controller_state_are_independent\ncargo test -p loopflow --test task_pr_authority_tests managed_task_submit_assigns_for_human_review\ncargo test -p loopflow --test land_tests land_collapses_checkpoint_history_and_pushes_the_final_tree_once\nuv run pytest python/tests/test_architecture.py\n```\n\nObserve that independent Runs can bind to the same Task without installing controller state, Work facts and controller cursors persist independently, managed Tasks can enter human review without a controller, and landing collapses checkpoint history into one recoverable authored commit.\n\n## Why it matters\n\nWave, Project, and Task records are durable operating facts, not ownership leases for one automation process. Separating them from the built-in controllers lets humans, bounded agents, cron jobs, and alternative orchestration compose the same execution and delivery primitives without impersonating or advancing an end-to-end controller.\n\n## What changed\n\n- Split the source and persistence model into controller-free `work` records and controller-owned Wave, Project, and Task automation state, including migration of existing playheads\n- Added `task prepare` and `project prepare`, plus `--task`, `--project`, and `--wave` bindings for independent Work-scoped Runs\n- Added Task restart as an explicit checkpoint-and-reset operation while preserving Task, worktree, and PR identity\n- Moved Work resolution outside the execution kernel and recorded exact prepared prompt context alongside immutable Run evidence\n- Removed provider writer leases, allowed managed Tasks through the human-submit path, and made land collapse intermediate checkpoints before pushing the verified head\n- Updated built-in skills and architecture documentation around the new Work, controller, execution, and delivery boundaries\n\n## Risks / Not included\n\n- Concurrent Work-bound Runs are intentionally not file-edit transactions; callers must use distinct paths and reconcile shared edits before checkpointing\n- Delivery commands act on Task delivery facts and do not certify that a particular controller Flow or gate ran","files":[],"additions":6119,"deletions":3754,"changed_files":162,"merge_commit":"fa0186c4d85c863e6c70e0e5c85adec921c43b93"},{"number":1237,"title":"LOO-265: Make Task promotion recovery depend on live process truth","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-265 — Make Task promotion recovery depend on live process truth](https://linear.app/loopflow/issue/LOO-265/make-task-promotion-recovery-depend-on-live-process-truth)\n> **Task cycle:** fix\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## Summary\n\nReplace Loopflow's SQL-backed Invocation/Turn execution lifecycle with decentralized, Home-local Run records. A provider launch now owns three durable facts: an immutable manifest published before spawn, an append-only event stream, and one exclusive terminal receipt.\n\nThis removes the old execution control plane instead of bridging both models. Ordinary unbound headless launches no longer depend on planning SQLite or dual-write Invocation/Turn authority. Bound Work retains its planning and delivery authority; Run identity is evidence and causality only.\n\n## What changed\n\n- Delete the SQL Invocation/Turn/Epoch/Basis trace, replay-index, artifact, access-control, and reconciliation layers that no longer earn their concepts.\n- Record provider lifecycle, raw output, conversation, cumulative direct usage, retries, and terminal settlement in `$LF_HOME/runs/<prefix>/<run-id>/`.\n- Preserve provider-authored cumulative counters, omissions, resets, and finality without per-event fsync or synthetic final usage.\n- Keep telemetry nonfatal and terminal settlement immutable. A conflicting second terminal writer loses.\n- Record no `owner.json` until an exact birth-validated process scope exists; no owner means no signal authority.\n- Add `lf runs <id>`, `lf runs <id> --events`, and `lf replay <id>` over the same Run record—no replay database, index, artifact store, Invocation, or Turn.\n- Record the effective prompts, agent/model, stable non-secret account ID, turn cap, Chrome capability, permission mode, and filesystem boundary before spawn.\n- Resolve replay accounts from the selected Home's deterministic credential directory or an explicit forwarded lease, not planning SQLite or current repository routes.\n- Replay through the ordinary harness as a new child Run, preserve the source, use one explicit Home throughout, and refuse unsupported schemas or managed Runs without an exact account.\n- Distinguish a malformed complete event from a torn final append; only the latter remains a readable evidence gap.\n- Rewrite the public and hidden developer docs around one Skill run first, local-by-default Home evidence, explicit `lf ssh` remote reads, and the smaller execution model.\n\n## Behavioral boundaries\n\n- Environment values, credential bytes, resume tokens, callbacks, repository contents, and process ownership are not replay inputs.\n- Current credentials and repository contents remain live launch inputs.\n- Normal credential failover remains multiple attempts inside one Run; attempt evidence names the non-secret account actually used.\n- Replay of an exact recorded account fails closed rather than silently selecting a different identity.\n- Bound Work and interactive handoff paths retain their distinct authority until later coherent deletion slices.\n\n## Review\n\nThe Mitchell-style review found and fixed dropped non-Claude system prompts, mismatched source/child Homes, SQLite-backed exact-account resolution, unpinned managed replay, unsupported schema acceptance, conflated corrupt/torn events, and missing failover account evidence.\n\n## Proof\n\n- `cargo test -p loopflow run_record::tests --lib`\n- `cargo test -p loopflow lf::commands::replay::tests --lib`\n- `cargo test -p loopflow provider_account::account_first_tests --lib`\n- `cargo test -p loopflow engine::agent::tests --lib`\n- `cargo test -p loopflow --bin lf`\n- `cargo fmt --all -- --check`\n- `cargo clippy -p loopflow --all-targets -- -D warnings`\n- `uv run python scripts/check_architecture.py`\n- `uv run pytest python/tests/test_architecture.py`\n- `uv run --project website pytest website/tests/test_portable_architecture.py`\n\nThe focused launch/replay proofs make `LF_DB_PATH` an unreadable directory. The fake provider receives a fresh Run ID,","files":[],"additions":14853,"deletions":54784,"changed_files":202,"merge_commit":"5f7f66833dafc7cc9e8f1a06cf49f822af0def87"},{"number":1239,"title":"LOO-246: Make trace audits survive persisted capture schemas","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-246 — Make trace audits survive persisted capture schemas](https://linear.app/loopflow/issue/LOO-246/make-trace-audits-survive-persisted-capture-schemas)\n> **Task cycle:** fix\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## Evaluate\n\nRun the focused reader contract:\n\n```bash\ncargo test -p loopflow trace::tests::conversation_ -- --nocapture\n```\n\nAll five tests pass. They cover the six measured historical usage shapes, the\nfrozen current wire shape, unsupported versions and event types, partial or\nunknown fields, null values, and truncated tails.\n\nThe production-like proof used `lf 0.12.14+2397bfcae` against a migrated SQLite\nbackup and the authoritative retained trace tree:\n\n- Before: 1,767 false capture integrity failures from valid historical usage\n  records.\n- After: 273,937 ledger rows and 1,379,917,455 conversation bytes audited with\n  no schema or integrity failure.\n- Still visible: eight historical gap days, 71 genuine partial captures, 226\n  interrupted captures, 87 lost captures, and incomplete provider usage.\n\nA retained indexed `turn_usage` record also renders through `lf trace --events`\nas `usage_checkpoint` with `final_receipt: true`.\n\n## Why it matters\n\nThe local trace is a lifetime record, but schema version 1 outlived two Rust\nusage enum vocabularies. A fully migrated store therefore looked corrupt even\nwhen its retained JSONL was intact. This restores trust in the audit without\nhiding real capture loss or changing what current providers emit.\n\n## What changed\n\n- Make `TraceSchemaVersion::V1` an explicit read-dispatch boundary with a\n  `CURRENT` mapping and unsupported-version error.\n- Normalize only the four observed outer `usage` shapes and two observed inner\n  `turn_usage` shapes into the current `usage_checkpoint` event.\n- Freeze both the historical compatibility corpus and current emitter shape.\n- Route typed `lf trace --events` output through the same versioned reader as\n  `lf doctor`; raw `--jsonl` remains byte-preserving.\n\n## Risks / Not included\n\nUnknown or partial historical shapes deliberately remain errors; there are no\ndefaults or legacy DTOs. This does not repair replay, context manifests,\nmetrics, historical gaps, missing artifacts, provider usage, or SQLite locking.\n\nThe changed-aware all-Rust gate was blocked before product tests by unrelated\nactive worktree build roots exceeding the repository resource envelope.\nFocused reader tests, formatting, clippy, and the complete retained-corpus audit\npassed; CI owns the full Rust suite.","files":[],"additions":373,"deletions":30,"changed_files":4,"merge_commit":"b4c13a75c41281a88242c2b4a2454f52d81fe8df"},{"number":1240,"title":"LOO-129: Replay any recent run from its recorded execution contract","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-129 — Replay any recent run from its recorded execution contract](https://linear.app/loopflow/issue/LOO-129/replay-any-recent-run-from-its-recorded-execution-contract)\n> **Task cycle:** feature\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## Evaluate\n\n```bash\ncargo test -p loopflow --test replay_tests\ncargo test -p loopflow --test dto_fixtures replay_check_fixture_locks_required_fields_and_every_refusal_code\n```\n\nThe integration tests prove that a complete contract is eligible, while legacy, corrupted, ambiguous, and wrong-Home cases return deterministic refusals without launching a provider or mutating recorded artifacts. The DTO fixture locks the required JSON shape and all 21 refusal codes.\n\n## Why it matters\n\nExact replay cannot safely reconstruct missing inputs from current configuration. This creates a fail-closed gate that verifies the recorded source, provider runtime, prompts, context, conversation, and execution boundaries before any future replay launch can occur.\n\n## What changed\n\n- Added `lf replay check <invocation>`, accepting a full invocation ID or literal unambiguous prefix and returning text or typed JSON\n- Defined versioned replay and execution contracts with content-addressed artifact references\n- Added the durable replay-contract index and read-only store queries\n- Validated Home authority, artifact hashes, ledger identity, turn timing, context manifests, conversation integrity, repository revision, provider runtime, and safe headless execution settings\n- Extended the `lfd` startup receipt timeout to 30 seconds and kept its diagnostic synchronized with the configured duration\n\n## Risks / Not included\n\n- This change checks eligibility only; it does not capture contracts or launch providers\n- Invocations without a producer-finalized contract deliberately refuse instead of falling back to ambient state","files":[],"additions":2445,"deletions":4,"changed_files":18,"merge_commit":"55918b3abcf404da4055dd874f231ecc9d29b666"},{"number":1241,"title":"LOO-271: Record immutable execution contracts for replay","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-271 — Record immutable execution contracts for replay](https://linear.app/loopflow/issue/LOO-271/record-immutable-execution-contracts-for-replay)\n> **Task cycle:** feature\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## Evaluate\n\n```bash\ncargo test -p loopflow --lib complete_native_codex_capture_is_bound_before_launch_and_replay_eligible\ncargo test -p loopflow --lib replay_safe_\n```\n\nObserve that preparation records the exact launch without starting the provider, the replay index remains absent until terminal provider evidence arrives, and the completed capture is deterministically replay-eligible. Refusal cases stop dirty worktrees, missing models or accounts, and lifecycle hooks before provider launch.\n\n## Why it matters\n\n`lf replay check` can only make a trustworthy decision when the source run records what actually launched before configuration, routing, or repository state can change. Immutable producer contracts prevent eligibility from being reconstructed from the current machine or granted to partial captures.\n\n## What changed\n\n- Prepared fresh headless native Codex invocations by pinning the model, managed account, executable and runtime hashes, layered configuration, repository commit, prompts, process settings, sanitized arguments, and selected environment\n- Added `--replay-safe` for a clean, detached, worktree-only boundary with an explicit model; it disables networked tools, Apps, MCP servers, notifications, retries, and directive relays, and refuses lifecycle hooks\n- Started Codex through the prepared invocation across direct, Task, Project, and Wave execution paths so the launched process matches the recorded contract\n- Published content-addressed execution artifacts before launch, then atomically indexed the final replay contract only after complete terminal Turn and conversation evidence\n- Preserved unsafe authority in ordinary managed captures so `lf replay check` reports the real boundary instead of treating it as eligible\n\n## Risks / Not included\n\n- Strict replay-safe capture is limited to fresh headless native managed Codex invocations; interactive or resumed sessions, leased-token authority, other providers, and dirty worktrees remain unsupported or ineligible\n- This change records and validates replay inputs; it does not launch the recorded replay","files":[],"additions":2019,"deletions":118,"changed_files":16,"merge_commit":"b2ed5cd788bc6a744eea86b7755a5f8be75173cf"},{"number":1245,"title":"wave: reconcile durable main context","body":"## Usage\n\n```bash\ngit show --stat origin/main\n```\n\n## Summary\n\nPreserve the release-recovery evidence lost during an earlier main restoration and initialize the list wave from its current Linear-backed context. This reconciles the local canonical branch through the protected merge queue so task worktrees can start from origin/main.","files":[],"additions":62,"deletions":0,"changed_files":3,"merge_commit":"a72c6c7ff1a36c82a56d113f5adf9b73070fba9f"},{"number":1247,"title":"release: decouple artifact identity from Home compatibility","body":"## Why\n\nv0.12.14 emits its candidate identity before refusing promotion against the release host’s live Home. The publisher treated that expected nonzero exit as an invalid artifact and never read the identity.\n\n## Change\n\n- Capture candidate preflight output without requiring a successful Home verdict.\n- Continue to require a parseable candidate with published migration authority.\n- Cover a published candidate that emits JSON and exits nonzero.\n\n## Proof\n\n- `uv run pytest python/tests/test_release_publisher.py python/tests/test_release_automation.py -q`\n- `uv run ruff check scripts/publish_release.py python/tests/test_release_publisher.py`","files":[],"additions":18,"deletions":1,"changed_files":2,"merge_commit":"696082a9b1817f192aadfe002ef2252fbc437cb6"},{"number":1248,"title":"LOO-241: Make ledger continuity failures match scheduled obligations","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-241 — Make ledger continuity failures match scheduled obligations](https://linear.app/loopflow/issue/LOO-241/make-ledger-continuity-failures-match-scheduled-obligations)\n> **Task cycle:** fix\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## Evaluate\n\n```bash\ncargo test -p loopflow lf::commands::doctor::tests\ncargo test -p loopflow ops::cron::tests\ncargo test -p loopflow --test doctor_tests copied_production_history_does_not_block_the_telemetry_scorecard\n```\n\nObserve that:\n\n- A missing receipt for the latest due interval fails continuity and names the cron, Home, interval, and inspection command.\n- Scheduled receipts prove the scheduler fired even when the target failed; manual receipts do not.\n- Pre-activation and older ledger gaps remain visible without blocking the telemetry scorecard.\n- Unchanged cron syncs preserve activation time, while legacy jobs recover it from their earliest matching scheduled receipt.\n\n## Why it matters\n\nRaw ledger silence made historical outages permanent failures, so healthy current scheduling could not restore `lf doctor` or daily telemetry to green. Continuity now follows durable scheduler obligations, making a failure evidence of a current missed firing instead of an old gap that no present action can repair.\n\n## What changed\n\n- Persisted activation time in installed cron metadata and retained it while the Home, schedule, target, and identity remain unchanged.\n- Derived each fixed-daily cron's latest due local-time interval and required an exactly matching scheduled receipt within that window.\n- Kept ledger gap days as historical context without treating them as current failures.\n- Added actionable diagnostics and end-to-end coverage proving telemetry proceeds without rewriting copied production history.\n\n## Risks / Not included\n\n- Continuity evaluates only the latest due interval; it does not backfill or fail on older missed intervals.\n- A target failure remains actionable through its receipt and target error rather than being reported as a scheduler continuity failure.","files":[],"additions":748,"deletions":85,"changed_files":6,"merge_commit":"b2edd7f5dde31eaa8b1130ebb79b229049ac6ab3"},{"number":1249,"title":"release: prove exact candidates before tagging","body":"## Evaluate\n\n```bash\ncargo test -p loopflow --test release_tests release_run_proves_the_candidate_before_pushing_the_version_tag\ncargo test -p loopflow --test release_tests release_run_prepares_signed_artifacts_before_pushing_the_version_tag\ncargo test -p loopflow --test release_tests failed_candidate_build_reuses_the_version_after_a_fix_merges\nuv run pytest python/tests/test_release_automation.py python/tests/test_release_publisher.py\n```\n\nObserve that the simulated remote remains untagged until the candidate workflow and publisher preparation succeed. A successful run tags the exact tested commit and publishes receipt-matched artifacts; a failed candidate leaves the version available for retry after a fix merges.\n\n## Why it matters\n\nThe previous flow created the immutable version tag before the release build and signing path had proven the candidate. A failed build therefore consumed the version and left recovery anchored to a bad tag. The tag now acts as an attestation that the exact commit and artifact bytes passed hosted validation and publisher preparation.\n\n## What changed\n\n- Dispatches release builds explicitly from provisional, exact-commit candidate refs and matches workflow results by branch and head SHA\n- Reuses one credential-free package matrix for nightly and release candidates, with candidate binaries reporting the intended final version before the tag exists\n- Splits publisher work into pre-tag `prepare` and post-tag `publish` phases\n- Stores prepared artifacts under `.lf/releases/` with receipts binding the tag, source commit, workflow run, completed proof stages, and artifact hashes\n- Revalidates the receipt and every artifact before publication, then removes successful candidate state\n- Preserves failed candidates for inspection and retries the same unconsumed version after a merged fix\n\n## Risks / Not included\n\n- The release workflow is now an explicit candidate dispatch contract; tag pushes no longer trigger builds or auto-tagging\n- Credentialed signing, registry upload, deployment, and finalization remain owned by the maintained publisher host; GitHub Actions stays credential-free","files":[],"additions":1084,"deletions":218,"changed_files":17,"merge_commit":"ee302c4fea7f3ad9b796c00fb148a5d31f3587c5"}],"decisions":null,"previous_release_notes":"# v0.12.14\n\n<!-- loopflow:release-notes=narrative;gate=safe -->\n\nv0.12.14 makes PR landing a completion lifecycle instead of an auto-merge request. `lf pr land` now owns an exact PR head through CI repair, confirmed merge, and Task settlement, preventing completion or branch rotation from racing ahead of GitHub. Upgrade when automated shipping needs to recover from CI failures and finish against authoritative merge state; use `lf pr arm` when request-and-return behavior is still the right fit.\n\n## Finish only after the PR merges\n\nLanding now follows the PR until GitHub reports a merge or an actionable blocker. Task state changes happen after that confirmation, so the repository and Loopflow no longer disagree about whether work has shipped.\n\n- `lf pr land` watches the exact PR head through merge instead of returning after it requests auto-merge.\n- Task completion and serial PR rotation occur only after GitHub confirms the merge.\n- If the head changes during landing, Loopflow re-arms the new head rather than treating the earlier request as sufficient.\n- `lf pr land -c` completes the owning Task after the watched merge succeeds.\n\n## Repair CI under one durable owner\n\nCI recovery is now part of the landing lifecycle itself. Persisted landing generations and incident records let supervision resume safely after interruption without launching competing repair paths.\n\n- A failed head can launch one bounded `ci-fix` repair for that failure identity.\n- Fenced supervisor claims, heartbeats, and Home daemon recovery preserve ownership across process restarts.\n- The Task runner's separate CI repair flow has been removed, leaving landing responsible for repair and post-merge settlement.\n\n## Operational notes\n\n- `lf pr land` is now a watched command. Use `lf pr arm` for the previous one-shot behavior that requests exact-head auto-merge and returns.\n- Submit, arm, and land preparation collapse authored history into one tree-identical commit before publishing. Expect the prepared PR head and authored commit history to change while the resulting tree remains the same.","source_limits":{"context_bytes":131072,"commits":256,"merged_prs":200,"files_per_change":100,"area_scopes":32,"name_bytes":256,"title_bytes":300,"path_bytes":512,"pr_body_bytes":4096,"decisions_bytes":16384,"previous_release_notes_bytes":16384,"release_notes_bytes":61440},"omissions":{"commits":0,"merged_prs":0,"commit_files":193,"pr_files":0,"area_scopes":0,"text_bytes":805,"decisions_bytes":0,"previous_release_notes_bytes":0}}