{"version":"0.12.15","prev_tag":"v0.12.14","target":"default","tag_prefix":"","area_scope":[],"commits":[{"sha":"49b3b403dc8ef6d46ec02390c26b6f82835d04fc","title":"Install unpublished local builds through the promotion path — install: safely promote unpublished local builds (#1229)","files":[".config/nextest.toml","README.md","docs/architecture.md","python/tests/test_canonicalize_migrations.py","python/tests/test_install_script.py","release/README.md","rust/loopflow/Cargo.toml","rust/loopflow/build.rs","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/bin/lfd.rs","rust/loopflow/src/build_info.rs","rust/loopflow/src/engine/process.rs","rust/loopflow/src/lf/commands/doctor.rs","rust/loopflow/src/lf/commands/install.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/lfd/mod.rs","rust/loopflow/src/lfd/service.rs","rust/loopflow/src/lib.rs","rust/loopflow/src/machine_install.rs","rust/loopflow/src/migration_drafts.rs","rust/loopflow/src/ops/project.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/promotion_lock.rs","rust/loopflow/src/store/durable.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/tests/local_promotion.rs","scripts/canonicalize_migrations.py","scripts/install.py","tests/fixtures/migrations/draft_manifest.json"]},{"sha":"a4c73a4c7cc317f9d75a12f583d9bbb1aaee856f","title":"Read historical CI-incident Runs during local promotion — runs: read historical CI incident triggers (#1235)","files":["rust/loopflow/src/durable.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/sqlite/durable.rs"]},{"sha":"b4c13a75c41281a88242c2b4a2454f52d81fe8df","title":"LOO-246: Make trace audits survive persisted capture schemas (#1239)","files":["rust/loopflow/src/lf/commands/runs.rs","rust/loopflow/src/trace.rs","rust/loopflow/tests/fixtures/trace/current_usage_checkpoint.jsonl","rust/loopflow/tests/fixtures/trace/historical_usage_variants.jsonl"]},{"sha":"55918b3abcf404da4055dd874f231ecc9d29b666","title":"LOO-129: Replay any recent run from its recorded execution contract (#1240)","files":["README.md","docs/architecture.md","docs/lf.md","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/lf/commands/mod.rs","rust/loopflow/src/lf/commands/replay.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/lfd/mod.rs","rust/loopflow/src/lib.rs","rust/loopflow/src/replay.rs","rust/loopflow/src/store/migrations/drafts/replay_contracts__3cf7cc7e3d8c4d7ea92cb65e8848aaf6.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/trace.rs","rust/loopflow/tests/dto_fixtures.rs","rust/loopflow/tests/replay_tests.rs","tests/fixtures/dto/README.md","tests/fixtures/dto/replay_check.json"]},{"sha":"b2ed5cd788bc6a744eea86b7755a5f8be75173cf","title":"LOO-271: Record immutable execution contracts for replay (#1241)","files":["docs/lf.md","rust/loopflow/src/engine/agent.rs","rust/loopflow/src/engine/launch.rs","rust/loopflow/src/engine/mod.rs","rust/loopflow/src/flowloop/wave.rs","rust/loopflow/src/harness/claude.rs","rust/loopflow/src/harness/codex.rs","rust/loopflow/src/harness/mod.rs","rust/loopflow/src/lf/commands/replay.rs","rust/loopflow/src/lf/commands/run.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/project/runner.rs","rust/loopflow/src/provider_account.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/task/runner.rs","rust/loopflow/src/trace.rs"]},{"sha":"5f7f66833dafc7cc9e8f1a06cf49f822af0def87","title":"LOO-265: Make Task promotion recovery depend on live process truth (#1237)","files":[".config/nextest.toml",".sesskey","README.md","TESTING.md","docs/agent-api.md","docs/architecture-reference.md","docs/architecture.css","docs/architecture.html","docs/architecture.md","docs/architecture/codebase.md","docs/architecture/data.md","docs/architecture/delivery.md","docs/architecture/execution.md","docs/architecture/homes.md","docs/architecture/planning.md","docs/authoring.md","docs/c