",".lf/chapters/20260923T000959Z-502f011b/application/new-task-2.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-2.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-3-verify.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-3-verify.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-3.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-3.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-4-verify.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-4-verify.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-4.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-4.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-5-verify.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-5-verify.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-5.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-5.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-6-verify.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-6-verify.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-6.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-6.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-7-verify.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-7-verify.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-7.stderr",".lf/chapters/20260923T000959Z-502f011b/application/new-task-7.stdout",".lf/chapters/20260923T000959Z-502f011b/application/new-task-plan.json",".lf/chapters/20260923T000959Z-502f011b/application/operations.jsonl",".lf/chapters/20260923T000959Z-502f011b/application/pm-doctor-before.txt",".lf/chapters/20260923T000959Z-502f011b/application/product-pm-before.stderr",".lf/chapters/20260923T000959Z-502f011b/application/product-pm-before.stdout",".lf/chapters/20260923T000959Z-502f011b/application/product-pm-final.stderr",".lf/chapters/20260923T000959Z-502f011b/application/product-pm-final.stdout",".lf/chapters/20260923T000959Z-502f011b/application/product-pm-renamed-loopflow-api.stderr"]},{"sha":"c56340a142bcb6a854b98fed9b757cd9a6423f9a","title":"LOO-292: Make laptop refresh and lf rebase on main reliably catch up (#1273)","files":[".github/workflows/ci.yml",".lf/env-setup.sh","Brewfile","README.md","TESTING.md","docs/architecture-reference.md","docs/lf.md","python/tests/test_checkout_refresh.py","python/tests/test_install_script.py","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/engine/git.rs","rust/loopflow/src/engine/worktrees.rs","rust/loopflow/src/lf/commands/mod.rs","rust/loopflow/src/lf/commands/ops/mod.rs","rust/loopflow/src/lf/commands/refresh.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/ops/checkout.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/src/ops/rebase.rs","scripts/install.py"]},{"sha":"e0849bad498ff8dfb51b344eba3f7520a44d906e","title":"execution: replace resident controllers with bounded task workers (#1270)","files":[".lf/directions/testing.md",".lf/skills/compress.md","TESTING.md","docs/agent-api.md","docs/architecture-reference.md","docs/architecture.html","docs/architecture.md","docs/architecture/codebase.md","docs/architecture/data.md","docs/architecture/delivery.md","docs/architecture/homes.md","docs/architecture/planning.md","docs/authoring.md","docs/conducting.md","docs/getting-started.md","docs/lf.md","docs/troubleshooting.md","docs/waves.md","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/child.rs","rust/loopflow/src/controller/mod.rs","rust/loopflow/src/controller/project/mod.rs","rust/loopflow/src/controller/project/state.rs","rust/loopflow/src/controller/runner.rs","rust/loopflow/src/controller/store.rs","rust/loopflow/src/controller/task/mod.rs","rust/loopflow/src/controller/task/state.rs","rust/loopflow/src/controller/wave/chat_reply.rs","rust/loopflow/src/controller/wave/journal.rs","rust/loopflow/src/controller/wave/mod.rs","rust/loopflow/src/controller/wave/playhead.rs","rust/loopflow/src/controller/wave/runner.rs","rust/loopflow/src/controller/wave/runtime.rs","rust/loopflow/src/durable.rs","rust/loopflow/src/engine/builtins/LOOPFLOW.md","rust/loopflow/src/engine/builtins/ops/skill/pr-land.md","rust/loopflow/src/engine/builtins/ops/skill/pr-submit.md","rust/loopflow/src/engine/builtins/project/skill/project_operate.md","rust/loopflow/src/engine/builtins/task/skill/5whys.md","rust/loopflow/src/engine/builtins/task/skill/ci-fix.md","rust/loopflow/src/engine/builtins/wave/skill/wave_operate.md","rust/loopflow/src/engine/flow.rs","rust/loopflow/src/engine/process.rs","rust/loopflow/src/journal/mod.rs","rust/loopflow/src/lf/commands/install.rs","rust/loopflow/src/lf/commands/ops/mod.rs","rust/loopflow/src/lf/commands/run.rs","rust/loopflow/src/lf/commands/session.rs","rust/loopflow/src/lf/commands/top.rs","rust/loopflow/src/lf/commands/waves.rs","rust/loopflow/src/lf/commands/work.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/ops/child.rs","rust/loopflow/src/ops/human_session.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/src/ops/pm.rs","rust/loopflow/src/ops/pr_landing.rs","rust/loopflow/src/ops/project.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/ops/task_pm.rs","rust/loopflow/src/planning.rs","rust/loopflow/src/pm/linear.rs","rust/loopflow/src/pm/mod.rs","rust/loopflow/src/store/children.rs","rust/loopflow/src/store/durable.rs","rust/loopflow/src/store/migrations.rs","rust/loopflow/src/store/migrations/drafts/drop_project_fingerprint__fc05be41a042145d385363fe64c55436.sql","rust/loopflow/src/store/migrations/drafts/task_worker_claim__1b4ed58b17917dcbecc35d4e5869b8c8.sql","rust/loopflow/src/store/migrations/drafts/work_domain_state__d15fa3a4ea161cd7739b1726b6029dad.sql","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","rust/loopflow/src/store/sqlite/children.rs","rust/loopflow/src/store/sqlite/controller.rs","rust/loopflow/src/store/sqlite/durable.rs","rust/loopflow/src/wave_host.rs","rust/loopflow/src/work/project.rs","rust/loopflow/src/work/task/mod.rs","rust/loopflow/tests/dto_fixtures.rs","rust/loopflow/tests/pr_tests.rs","rust/loopflow/tests/repository_team_matrix.rs","rust/loopflow/tests/status_tests.rs","rust/loopflow/tests/support/mod.rs","rust/loopflow/tests/task_github_cache_tests.rs","rust/loopflow/tests/task_initialization_tests.rs","rust/loopflow/tests/wave_journal_tests.rs","rust/loopflow/tests/wave_repository_ownership.rs","rust/loopflow/tests/wave_start_tests.rs","swift/Loopflow/Models/WaveWorkMap.swift","swift/LoopflowMac/MacLocalWaveAgentLauncher.swift","swift/LoopflowMac/MockWaveFixture.swift","swift/LoopflowTests/DTOFixtureTests.swift","swift/LoopflowTests/LocalWaveAgentLauncherTests.swift","swift/LoopflowTests/RegistryQueryTests.swift","tests/fixtures/dto/pm_show.json","tests/fixtures/dto/roadmap_snapshot.json","tests/fixtures/dto/wave_detail.json","tests/goldens/basic.md","tests/goldens/builtin_debug.md","tests/goldens/builtin_implement.md"]},{"sha":"88cf10641b0e88fc4bfcf504ef62bed4aa057539","title":"LOO-279: Make Linear OAuth recovery survive unattended Project runs (#1274)","files":["TESTING.md","docs/lf.md","rust/loopflow/src/lf/commands/ssh.rs","rust/loopflow/src/ops/pm.rs","rust/loopflow/src/ops/pm/oauth_tests.rs","rust/loopflow/src/pm/mod.rs","rust/loopflow/src/provider_auth/mod.rs","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite.rs","tests/e2e/linear_oauth.py"]},{"sha":"7160f3637b590988cd2304a186d5c80941c44b65","title":"steering: route task direction through linear comments (#1275)","files":[".lf/directions/testing.md","README.md","docs/agent-api.md","docs/architecture-reference.md","docs/architecture.html","docs/architecture.md","docs/architecture/planning.md","docs/conducting.md","docs/getting-started.md","docs/index.md","docs/lf.md","docs/troubleshooting.md","docs/waves.md","rust/loopflow/src/bin/lf.rs","rust/loopflow/src/controller/task/mod.rs","rust/loopflow/src/controller/wave/README.md","rust/loopflow/src/controller/wave/discord.rs","rust/loopflow/src/controller/wave/journal.rs","rust/loopflow/src/controller/wave/mod.rs","rust/loopflow/src/controller/wave/runner.rs","rust/loopflow/src/controller/wave/runtime.rs","rust/loopflow/src/controller/wave/server.rs","rust/loopflow/src/controller/wave/supervisor.rs","rust/loopflow/src/controller/wave/wire.rs","rust/loopflow/src/engine/builtins/LOOPFLOW.md","rust/loopflow/src/engine/builtins/project/skill/project_operate.md","rust/loopflow/src/lf/commands/chat.rs","rust/loopflow/src/lf/commands/waves.rs","rust/loopflow/src/lf/commands/work.rs","rust/loopflow/src/lf/mod.rs","rust/loopflow/src/lfd/mod.rs","rust/loopflow/src/ops/child.rs","rust/loopflow/src/ops/linear_observe.rs","rust/loopflow/src/ops/mod.rs","rust/loopflow/src/ops/pm.rs","rust/loopflow/src/ops/pm/oauth_tests.rs","rust/loopflow/src/ops/project.rs","rust/loopflow/src/ops/run.rs","rust/loopflow/src/ops/task.rs","rust/loopflow/src/pm/linear.rs","rust/loopflow/src/pm/mod.rs","rust/loopflow/src/store/children.rs","rust/loopflow/src/store/durable.rs","rust/loopflow/src/store/mod.rs","rust/loopflow/src/store/sqlite/children.rs","rust/loopflow/src/store/sqlite/durable.rs","rust/loopflow/src/webhook.rs","rust/loopflow/tests/linear_observe_tests.rs","rust/loopflow/tests/linear_webhook_tests.rs","rust/loopflow/tests/task_github_cache_tests.rs","swift/Loopflow/Services/WaveChatClient.swift","swift/LoopflowMac/Views/WaveChatView.swift","swift/LoopflowTests/WaveChatConnectionTests.swift","swift/README.md","tests/fixtures/dto/resident_deltas.json","tests/goldens/basic.md","tests/goldens/builtin_debug.md","tests/goldens/builtin_implement.md","tests/goldens/builtin_review_slice.md","tests/goldens/with_direction.md","tests/goldens/with_docs.md"]}],"merged_prs":[{"number":1270,"title":"execution: replace resident controllers with bounded task workers","body":"## Evaluate\n\n```bash\ncargo test -p loopflow --lib controller::task::planning_tests\ncargo test -p loopflow --lib store::sqlite::durable::tests\ncargo test -p loopflow --lib store::migrations::tests\ncargo test -p loopflow --lib ops::pr_landing::tests\n```\n\nThese tests cover:\n\n- One worker advancing one saved Task boundary; interrupted work resumes in place, stale workers and human decisions cannot advance replacements, and completed Flows stop.\n- Active invocations retaining their selected definition despite later Flow or Skill edits.\n- Historical database upgrades preserving Work and human-session facts while marking incompatible positions for explicit restart.\n- CI repairs handing back a newly published, armed head; unchanged or unarmed repairs block, and Task completion or rotation survives the handoff.\n\nCommands are the review path; tests were not rerun while generating this description.\n\n## Why it matters\n\nTask progress can survive provider exits without depending on a resident controller or its conversation history. Each worker starts from durable facts and can advance only its claimed position, keeping retries and concurrent launches from overwriting newer progress. Projects operate through finite Runs, while delivery retains explicit ownership of publication and merge.\n\n## What changed\n\n- Replaced the Task `first → loop → finally` lifecycle with one persisted Flow invocation, versioned position, and worker claim. Each worker executes one boundary and launches its successor when autonomous work remains.\n- Removed the resident Project controller and its process controls. Project run and steer launch finite `project/operate` Runs; Projects recommend one Task Flow, overridden with `lf task run --flow`.\n- Preserved human approval, iteration, and resumable sessions against exact invocation identities. Ordinary Task-attributed Runs provide context without advancing the Flow.\n- Added forward migrations to retire controller state and updated CLI surfaces, Rust/Swift planning DTOs, documentation, and prompt fixtures.\n- Made `ci-fix` own rebase, verification, publication, and auto-merge. The landing watcher observes the repaired head and reports missing merge requests instead of re-arming them.\n- Isolated Task session-command tests from an installed `lf` executable.\n\n## Risks / Not included\n\n- Existing automation using `--first`, `--loop`, `--finally`, or removed Project process controls must adopt the new invocation model.\n- Legacy positions that cannot reconstruct a complete invocation require explicit restart; migration preserves their available session facts.\n- Finishing a Flow does not itself complete the Task or select another Flow. Delivery and Task completion remain explicit operations.","files":[],"additions":5546,"deletions":7044,"changed_files":104,"merge_commit":"e0849bad498ff8dfb51b344eba3f7520a44d906e"},{"number":1272,"title":"chapters: preserve planning boundaries and recover review evidence","body":"## Evaluate\n\n```bash\nuv run python .lf/chapters/20260923T000959Z-502f011b/application/verify.py\nuv run pytest python/tests/test_architecture.py\ncargo test -p loopflow final_answer\ncargo test -p loopflow child_drill\ncargo test -p loopflow harness::conformance_tests\n```\n\nThe archive verifier should report all 20 checks as true, including five accepted Projects, seven unproven KRs, eighteen open Tasks, preserved active work, and unchanged frozen sources. Rust tests cover final-answer extraction, recovery of older streamed output, duplicate-free chat rendering, and child discovery beyond the usual history limits. Architecture tests confirm historical chapter evidence is excluded while live instructions remain checked.\n\nInspect `.lf/chapters/README.md` for the baseline review and accepted chapter start. The baseline preserves 39 KR judgments and explicitly incomplete historical coverage; the new start records the accepted portfolio, dispositions, and application receipts.\n\n## Why it matters\n\nChapter planning needs a durable record of what was promised, what the evidence supports, and what the human accepted next. This change preserves that boundary in Git and makes delegated review reports recoverable from Run records, so missing launch output, retired goals, or incomplete evidence cannot silently disappear from the portfolio judgment.\n\n## What changed\n\n- Archive the September baseline, execution research, accepted September–October plan, and reconciliation receipts. Update the three retained Wave charters and memories; preserve the retired List charter and obsolete metric contract as history.\n- Have repository reviews launch Project reviews directly, reconcile exact KR lineage and verdict totals, and lead with the resulting user experience. Keep missing evidence explicit and distinguish outcome proof from implementation receipts.\n- Make chapter starts establish human direction before delegation, reuse accepted parent direction, and publish the accepted boundary through the normal PR workflow. Future reviews use the newest merged start record.\n- Add `lf runs --parent <run-id> --json` for uncapped direct-child discovery and `lf runs <run-id> --final` for durable conclusions. Preserve Codex final-answer receipts without repeating streamed text; label fallback output from older records.\n- Exclude frozen chapter evidence from current architecture checks and document the corresponding validation paths.\n\n## Risks / Not included\n\nThe application verifier checks retained receipts, not current provider state or achieved KR outcomes. Older Runs without final-answer receipts return labeled streamed prose that may include commentary. The archived portfolio decisions do not implement the planned Desktop, reliability, or external dogfood improvements.","files":[],"additions":52427,"deletions":398,"changed_files":1174,"merge_commit":"0bd9bb90d46a0638c54c042c6b26e94e0b25e8d7"},{"number":1273,"title":"LOO-292: Make laptop refresh and lf rebase on main reliably catch up","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-292 — Make laptop refresh and lf rebase on main reliably catch up](https://linear.app/loopflow/issue/LOO-292/make-laptop-refresh-and-lf-rebase-on-main-reliably-catch-up)\n> **PR lifecycle:** PR 1 is published for review; no Task settlement is requested.\n<!-- loopflow:task-pr-context:end -->\n\nRunning `lf rebase` on stale main fetched upstream but left HEAD unchanged, then failed ancestry verification. Main now catches up on every invocation. From a sibling worktree, rebase refreshes canonical main before integrating the caller; creating the next sibling preserves main's unpublished commits.\n\n## Evaluate\n\n- Run `lf rebase` on main or a sibling, advance upstream, then repeat. Each invocation fetches current upstream, preserves local commits and edits, and updates the caller as needed.\n- Run `lf install` to update main, required tools, the Python environment and the published release. Current complete installations skip downloads; missing or stale Mac applications still repair.\n- After release, run `lf install schedule` for login/hourly macOS refresh through the same installed command.\n\nThe candidate's current-main invocation completed in 1.75 seconds on the reporter's laptop, including fetch (one sample). The original installed-binary failure was reproduced against a local remote.\n\n## What changed\n\nOne preserving main updater serves rebase, install and ordinary worktree refresh. It fast-forwards or merges while retaining unpublished commit identities and staged, working and untracked edits. Shared-main and stash mutations are serialized without serializing independent feature rebase recovery. Placement previews remain read-only.\n\nFull install uses the existing dependency inventory and verified published promotion. The calendar LaunchAgent retries through that same command after missed or failed refreshes. Independent review found a missing-app fast-path bug; regression tests now prove missing, stale, invalid and incomplete Mac app bundles reach the installer.\n\n## Validation and remaining work\n\n- 19 real CLI checkout-refresh cases, 24 installer cases, 19 Rust rebase integration tests and 55 CLI parser tests passed.\n- Cargo formatting, Clippy with warnings denied, Ruff and architecture coverage passed. The new Homebrew subprocess is documented in the ownership map.\n- The changed-aware gate stopped before product suites: active canonical main's build cache is 19.1 GiB against a 12 GiB budget. Prescribed recovery cannot clean an active checkout. Full affected-suite verification is not claimed; hosted checks remain required.\n- Release and live scheduler activation are still required. The plist/reload proof is simulated; this PR does not claim a real scheduled firing or wake recovery. Keep the Task open for that evidence.\n\nTask placement and release/relocation reset semantics remain outside this change. No development build is promoted into the production Home.\n\nThe iteration 3 handoff changes documentation only. The latest independent installer replay passed 11 focused cases; executable bytes are unchanged. Hosted architecture, migrations, Rust lint, Python, Swift, website and smoke checks passed on 6a46d7170. Rust and UI tests were still running at review; scratch-clear awaits the pinned landing flow.","files":[],"additions":1218,"deletions":78,"changed_files":20,"merge_commit":"c56340a142bcb6a854b98fed9b757cd9a6423f9a"},{"number":1274,"title":"LOO-279: Make Linear OAuth recovery survive unattended Project runs","body":"<!-- loopflow:task-pr-context:start -->\n> [!NOTE]\n> **Task:** [LOO-279 — Make Linear OAuth recovery survive unattended Project runs](https://linear.app/loopflow/issue/LOO-279/make-linear-oauth-recovery-survive-unattended-project-runs)\n> **PR lifecycle:** Merging PR 1 completes the Task.\n<!-- loopflow:task-pr-context:end -->\n\n## Evaluate\n\n```bash\ncargo test -p loopflow linear_oauth\n# In the disposable Linux environment documented in TESTING.md:\nuv run tests/e2e/linear_oauth.py --lf /root/.local/bin/lf\n```\n\nThe installed candidate invokes `lf pm show --sync --json` against simulated\nLinear HTTPS. Expired credentials recover after a 503: two exchanges, three\nGraphQL reads accepting only the new bearer, fresh definition/KRs returned, and\nthe complete encrypted rotated pair persisted. Rejected grants with and without\na cached snapshot both exit 1 after one exchange and zero GraphQL reads,\npreserve state, emit no planning output, and retain Doppler-aware reconnect guidance.\n\n[CI run 35935048845](https://github.com/loopflowstudio/loopflow/actions/runs/35935048845)\ntested a tree identical to head `2079950b95d1aed33fcf5ef48d76962f2b7cfc4d`.\nCurrent head `012a34979ac6978268f73f841b4c1f09dd768f90` adds only gate\nhandoff documents; implementation, tests and configuration are unchanged.\nAfter materializing three migration drafts into a canonical test batch,\n`cargo nextest run --all` passed 1,920 tests with six skipped, including all 19\nOAuth cases. Rust formatting/Clippy, migration validation, architecture,\nPython, website, E2E smoke, Swift and app compilation passed. Fixture Ruff\nlint/format checks also passed. In that recorded run, only scratch cleanup kept\naggregate CI red; final required checks must pass after landing preparation.\n\n## Why it matters\n\nHeadless skills can obtain fresh Linear planning across ordinary credential\nexpiry without asking the maintainer to reconnect. When recovery cannot finish,\nthe command preserves authority and reports whether retry or reconnect is\nappropriate. Project skills remain free to continue from known KRs after a\nfailed planning read.\n\n## What changed\n\nThe shared PM resolver serializes refresh exchanges using a lock beside the\ncanonical database, validates a complete rotated credential pair, and persists\nit through encrypted conditional replacement. Interactive reconnect and deletion\nwin over stale exchanges. Blocking persistence retains the lock after caller\ncancellation; timeout never claims rollback. Temporary failures allow one\nbounded replay, returned credentials are checked for expiry, and sanitized\nfailure categories preserve the cause through forced-read errors. SSH uses the\nsame resolver for its optional local bearer.\n\n## Risks / Not included\n\nThe Home assumes local SQLite/file locks and recovery relies on Linear's grant\nreplay window. Two attempts share a five-second resolver deadline; that is not a\nwhole-CLI timing guarantee. One encrypted row remains authoritative. No Project\ncontroller, compulsory launch-time PM read, schema change or production endpoint\nconfiguration was added.\n\nInstalled expiry/rejection evidence uses synthetic HTTPS and a development\nHome. Candidate CLI digest:\n`ad72c83547fdc8b2f0ff99ecf41557cc1075518f8dc0acf0fabacd222dcf1e33`.\nIts source archive matches all seven OAuth Rust files in this head. The separate\nCI run supplies release-equivalent schema proof, not evidence of an already\npublished schema. No shared grant was copied, expired or replaced for testing.\nA configured candidate read against real Linear remains unavailable in its\nunconnected Home; published-baseline reads and forwarded bearers do not prove\ncandidate local recovery. Fourteen days of real operations remains a Reliability\nProject obligation. App compilation is not hosted UI interaction proof.\n\nThe prior demo preparation repeated the retained simulation and unconnected-Home\nfinding; it supplied no live-provider proof or human approval. Its duplicate\nscratch note was removed during handoff review without changing these limits.","files":[],"additions":1766,"deletions":263,"changed_files":10,"merge_commit":"88cf10641b0e88fc4bfcf504ef62bed4aa057539"},{"number":1275,"title":"steering: route task direction through linear comments","body":"## Evaluate\n\n```bash\ncargo nextest run -p loopflow --lib -E 'test(controller::task::) | test(controller::wave::) | test(ops::run::) | test(ops::linear_observe::) | test(pm::linear::) | test(ops::pm::)' --no-fail-fast\ncargo nextest run -p loopflow --test linear_observe_tests --test linear_webhook_tests --test task_github_cache_tests --no-fail-fast\nswift test --package-path swift --filter ComposerVerbTests\n```\n\nCheck that:\n\n- Posting direction leaves an idle Task idle, and independent Task-bound Runs exclude steering from their context.\n- Comment history spans every page; edits reconcile without duplicate delivery, and uncertain publication can recover the existing comment.\n- Wave HTTP requests reject steering and interrupts carrying text without journaling them; ordinary messages and bare interrupts retain their behavior.\n- The Mac composer offers Send for text and Interrupt for an active turn with an empty composer.\n\nThese are review commands; they were not run while preparing this description.\n\n## Why it matters\n\nTask corrections now have one authored record in Linear, whether entered directly on the issue or through `lf task steer`. Only the worker advancing that Task consumes them, so guidance does not unexpectedly start idle work or affect independent Runs sharing the Task context.\n\n## What changed\n\n- Publish Task direction to Linear before caching delivery locally, including attachment input and advice supplied during restart, recovery, retry, and human iteration.\n- Refresh comments before Skill execution and while workers run; ingest comment revisions from polling and webhooks, including human comments from Loopflow’s own account while filtering automated writebacks.\n- Record starting-prompt inclusion separately from live provider acceptance in Run traces.\n- Remove generic Work and Project steering, `lf chat --steer`, and Wave live-steering machinery. Project and Wave guidance moves to instructions passed to their operate skills. Historical Wave steering remains readable without replaying it.\n- Align CLI, Mac composer, protocol fixtures, documentation, and testing guidance with these boundaries.\n\n## Risks / Not included\n\n- Publishing direction and refreshing it before a Skill now require Linear availability. Bare Task interrupts remain local.\n- Publication and provider acceptance do not prove that the model followed the instruction; live consumption depends on provider scheduling.\n- Removed steering commands and Wave operations require callers to migrate.","files":[],"additions":979,"deletions":1518,"changed_files":61,"merge_commit":"7160f3637b590988cd2304a186d5c80941c44b65"}],"decisions":null,"previous_release_notes":"# v0.12.19\n\n<!-- loopflow:release-notes=narrative;gate=safe -->\n\nv0.12.19 keeps ongoing terminal work intact as you navigate the Mac app. Session panes retain their running clients and contents, moving a Session from another terminal requires an explicit action, and completed shell commands can be copied together with their output. The through-line is continuity: preserve the work already running and make terminal actions follow your focus.\n\n## Keep Sessions running as you move around\n\nClosing a Session pane or switching views should not interrupt its client. The app now retains pane layouts and live terminal surfaces per repository within each window, so returning to a Session restores the ongoing work.\n\n- Close and reopen Session panes, navigate between Sessions and Work, or switch repositories without losing the running client or terminal contents.\n- Selecting a Session active elsewhere leaves its client running until you choose **Move here**. The previous terminal then reports that the Session moved.\n- VIEWING, RUNNING, and ELSEWHERE states clarify terminal status, with recovery from provider exits.\n- Opening a Session beside a focused shell preserves that shell.\n\n## Copy a command and its output together\n\nShell panes now support selectable command blocks through the bundled Ghostty build. Completed commands and their output can be highlighted and copied as one block while the live prompt remains editable.\n\n- Click a completed command block and press Command-C to copy the command and output.\n- Terminal shortcuts follow the focused pane, including paste routing through split panes into live terminals.\n- Clipboard, image, and file-drop handling broaden terminal input support.\n\n## Operational notes\n\n- Terminal retention lasts for the window's lifetime. Closing a shell pane still ends its shell.\n- **Move here** discards unsent text in the previous client; the UI explains this before takeover.\n- Command blocks apply only to shell panes with supported shell integration. The pinned build excludes automatic integration for macOS `/bin/bash`.\n- The Ghostty framework is pinned with a checksum and bundled with matching shell integration and terminfo. A rebuild command is available for contributors maintaining the patched framework.\n\n## Small changes\n\n- Intentional provider termination for a Session move or completion exits cleanly; unexplained termination remains an error.","source_limits":{"context_bytes":131072,"commits":256,"merged_prs":200,"files_per_change":100,"area_scopes":32,"name_bytes":256,"title_bytes":300,"path_bytes":512,"pr_body_bytes":4096,"decisions_bytes":16384,"previous_release_notes_bytes":16384,"release_notes_bytes":61440},"omissions":{"commits":0,"merged_prs":0,"commit_files":1081,"pr_files":0,"area_scopes":0,"text_bytes":0,"decisions_bytes":0,"previous_release_notes_bytes":0}}