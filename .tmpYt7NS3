{"version":"0.12.20","prev_tag":"v0.12.19","target":"default","tag_prefix":"","area_scope":[],"commits":[{"sha":"0bd9bb90d46a0638c54c042c6b26e94e0b25e8d7","title":"chapters: preserve planning boundaries and recover review evidence (#1272)","files":[".lf/chapters/20260922-manual-baseline/chapter-review.html",".lf/chapters/20260922-manual-baseline/execution-architecture-evolution.md",".lf/chapters/20260922-manual-baseline/execution-architecture-synthesis.md",".lf/chapters/20260922-manual-baseline/research-decentralization-97b2ab32.md",".lf/chapters/20260922-manual-baseline/research-execution-narrative-claude-97b2ab32.md",".lf/chapters/20260922-manual-baseline/research-infrastructure-cross-wave-claude-97b2ab32.md",".lf/chapters/20260922-manual-baseline/review-evidence.md",".lf/chapters/20260922-manual-baseline/review-ledger.json",".lf/chapters/20260922-manual-baseline/review.md",".lf/chapters/20260922-manual-baseline/start-chapter-direction-draft.md",".lf/chapters/20260923-reconciliation.md",".lf/chapters/20260923T000959Z-502f011b/accepted-direction.md",".lf/chapters/20260923T000959Z-502f011b/application/before-format-correction/infrastructure-pm-final.stdout",".lf/chapters/20260923T000959Z-502f011b/application/before-format-correction/infrastructure-status-final.stdout",".lf/chapters/20260923T000959Z-502f011b/application/before-format-correction/product-pm-final.stdout",".lf/chapters/20260923T000959Z-502f011b/application/before-format-correction/product-status-final.stdout",".lf/chapters/20260923T000959Z-502f011b/application/decisions.md",".lf/chapters/20260923T000959Z-502f011b/application/engbot-status-before.stderr",".lf/chapters/20260923T000959Z-502f011b/application/engbot-status-before.stdout",".lf/chapters/20260923T000959Z-502f011b/application/expected-tasks.json",".lf/chapters/20260923T000959Z-502f011b/application/format-correction-observation.json",".lf/chapters/20260923T000959Z-502f011b/application/historical-reconciliation.json",".lf/chapters/20260923T000959Z