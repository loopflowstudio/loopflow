#!/bin/bash
# Start all loopflow development waves
set -e
cd "$(git rev-parse --show-toplevel)"

# One wave per area, multiple directions per wave
uv run lfd loop ship swift/ -d product-engineer -d designer
uv run lfd loop ship src/loopflow/ -d product-engineer -d designer
uv run lfd loop ship . -d infra-engineer

uv run lfd status
