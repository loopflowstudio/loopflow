--- /Users/jack/src/loopflow.de-slop-fable/website/static/style.css	2026-11-19 17:59:20
+++ website/static/style.css	2026-11-21 17:44:00
@@ -1527,3 +1527,28 @@
 .works li { align-content: start; }
 .home-page .works { padding-bottom: 0; }
 .home-page .work-row p.tag { font-size: var(--t-small); color: var(--burgundy); }
+
+/* Font set: Old Standard for titles from 24px, Atkinson Hyperlegible Next for interface and prose, Spline Sans Mono for commands. */
+:root {
+    --font-serif: 'Old Standard TT', Georgia, serif;
+    --font-sans: 'Atkinson Hyperlegible Next', -apple-system, BlinkMacSystemFont, sans-serif;
+    --font-mono: 'Spline Sans Mono', ui-monospace, monospace;
+}
+/* Old Standard is wider and sharper than the face it replaces: less negative tracking, and no serif under 24px. */
+.home-page h1 { letter-spacing: -.02em; line-height: 1.08; }
+.home-page h2 { letter-spacing: -.012em; line-height: 1.14; }
+.home-page .belief p { letter-spacing: -.012em; line-height: 1.14; }
+.docs-content h1 { letter-spacing: -.015em; }
+.appmock .waves h4 { font: 600 var(--t-text) var(--font-sans); }
+.docs-deck { font-family: var(--font-sans); font-style: normal; }
+.install-option h2 { font-weight: 400; }
+/* Old Standard runs wide: one step smaller and tighter than the first pass. */
+:root { --t-display: clamp(32px, 3.8vw, 54px); --t-title: clamp(28px, 2.8vw, 38px); --t-name: 30px; }
+.home-page h1 { letter-spacing: -.035em; }
+.home-page h2, .home-page .belief p { letter-spacing: -.025em; }
+.docs-content h1 { letter-spacing: -.03em; }
+.home-page h1, .home-page h2 { text-wrap: balance; }
+/* Old Standard's fl ligature reads as a collision in "Loopflow" and "workflow": set the letters apart and tighten the rest. */
+h1, h2, h3, h4, .docs-nav-wordmark, .home-page .belief p, .home-page .tag span { font-variant-ligatures: no-common-ligatures; }
+.docs-nav-wordmark, .docs-content h1, .hero h1, .page-hero h1, .install-option h2 { letter-spacing: -.03em; }
+.appmock.duo h3, .home-page .split h3 { letter-spacing: -.02em; }
