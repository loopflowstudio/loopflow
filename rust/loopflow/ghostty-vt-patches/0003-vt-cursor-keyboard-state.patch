+test "Terminal vt with origin and keyboard stack" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var t = try Terminal.init(testing.io, alloc, .{ .cols = 80, .rows = 24 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    s.nextSlice("\x1b[5;20r\x1b[?6h\x1b[3;8Hinside\x1b[>5u\x1b[>1u");
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+    var pin_map: PinMap.Map = .empty;
+    defer pin_map.deinit(alloc);
+    var formatter: TerminalFormatter = .init(&t, .vt);
+    formatter.extra = .all;
+    formatter.pin_map = .{ .alloc = alloc, .map = &pin_map };
+    try formatter.format(&builder.writer);
+    try testing.expectEqual(builder.writer.buffered().len, pin_map.count());
+    var restored = try Terminal.init(testing.io, alloc, .{ .cols = 80, .rows = 24 });
+    defer restored.deinit(alloc);
+    var viewer = restored.vtStream();
+    defer viewer.deinit();
+    viewer.nextSlice(builder.writer.buffered());
+    try testing.expectEqual(t.screens.active.cursor.x, restored.screens.active.cursor.x);
+    try testing.expectEqual(t.screens.active.cursor.y, restored.screens.active.cursor.y);
+    for (0..10) |_| {
+        try testing.expectEqual(t.screens.active.kitty_keyboard.current(), restored.screens.active.kitty_keyboard.current());
+        s.nextSlice("\x1b[<u");
+        viewer.nextSlice("\x1b[<u");
+    }
+}
