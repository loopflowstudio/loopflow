+-- name: own_flow_launch
+-- id: 96374fda80dad2dbfd86b23d34f95c84
+-- depends_on: name_tasks_on_flow_step_runs
+
+-- A Flow launched without a Task has no Task row to read its checkout and
+-- request from, so its invocation keeps what it was launched with. The
+-- selectors are the words of the launch: such a Flow never becomes its
+-- Task's managed invocation, so they are not `task_id`.
+ALTER TABLE flow_invocations ADD COLUMN cwd TEXT;
+ALTER TABLE flow_invocations ADD COLUMN message TEXT;
+ALTER TABLE flow_invocations ADD COLUMN model TEXT;
+ALTER TABLE flow_invocations ADD COLUMN wave_selector TEXT;
+ALTER TABLE flow_invocations ADD COLUMN task_selector TEXT;
+ALTER TABLE flow_invocations ADD COLUMN work_selector TEXT;
