+/// A Flow's invocation that names no Task: what it was launched with, its
+/// captured steps and its cursor.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FlowInvocation {
+    pub capture: QueuedInvocation,
+    pub cursor: ExecutionCursor,
+    pub version: u64,
+    pub cwd: std::path::PathBuf,
+    pub message: Option<String>,
+    pub model: Option<String>,
+    pub wave: Option<String>,
+    pub task: Option<String>,
+    pub as_work: Option<String>,
+    /// A driver began the current step and has not settled it.
+    pub claimed: bool,
+    pub current_run_id: Option<RunId>,
+    pub failure: Option<String>,
+    pub finished: bool,
+}
+
+impl FlowInvocation {
+    /// `None` once the cursor has passed the last step.
+    pub fn current_step(&self) -> Option<&ConcreteStep> {
+        let (steps, cursor) = self.cursor.current_body(&self.capture.steps);
+        steps.get(cursor.index)
+    }
+
+    pub fn is_human(&self) -> bool {
+        matches!(self.current_step(), Some(ConcreteStep::Skill(skill)) if skill.policy.human)
+    }
+
+    pub fn step_name(&self) -> Option<String> {
+        Some(match self.current_step()? {
+            ConcreteStep::Skill(skill) => skill.skill.name.clone(),
+            ConcreteStep::Op(op) => op.item.display_name(),
+            ConcreteStep::Xor(branch) => branch.router.name.clone(),
+        })
+    }
+}
