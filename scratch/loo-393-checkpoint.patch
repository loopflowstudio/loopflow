+    pub(crate) async fn publish_task_record(
+        &self,
+        revision: &crate::task_record::TaskRecordRevision,
+    ) -> PmResult<()> {
+        let response: Value = self
+            .graphql(
+                r#"mutation TaskRecord($input: AttachmentCreateInput!) {
+                attachmentCreate(input: $input) { success }
+            }"#,
+                json!({"input": {
+                    "issueId": revision.record.issue_id,
+                    "url": revision.url(),
+                    "title": "Loopflow Task record",
+                    "metadata": {"loopflowTaskRecord": serde_json::to_string(revision)
+                        .expect("Task record serializes")}
+                }}),
+            )
+            .await?;
+        if response
+            .pointer("/attachmentCreate/success")
+            .and_then(Value::as_bool)
+            != Some(true)
+        {
+            return Err(PmError::Message(
+                "Linear did not confirm Task record publication".into(),
+            ));
+        }
+        Ok(())
+    }
