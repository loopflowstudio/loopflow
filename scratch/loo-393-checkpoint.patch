+    pub(crate) async fn task_record_revisions(
+        &self,
+        issue_id: &str,
+    ) -> PmResult<Vec<crate::task_record::TaskRecordRevision>> {
+        let mut records = Vec::new();
+        for (url, metadata) in self.item_attachments(issue_id).await? {
+            if !url.starts_with(crate::task_record::RECORD_URL) {
+                continue;
+            }
+            let body = metadata
+                .as_ref()
+                .and_then(|value| value.get("loopflowTaskRecord"))
+                .and_then(Value::as_str)
+                .ok_or_else(|| {
+                    PmError::Message("Linear Task record attachment has no record".into())
+                })?;
+            let revision: crate::task_record::TaskRecordRevision = serde_json::from_str(body)
+                .map_err(|_| PmError::Message("Linear Task record attachment is invalid".into()))?;
+            if revision.url() != url || revision.record.issue_id != issue_id {
+                return Err(PmError::Message(
+                    "Linear Task record digest or issue identity does not match".into(),
+                ));
+            }
+            records.push(revision);
+        }
+        Ok(records)
+    }
