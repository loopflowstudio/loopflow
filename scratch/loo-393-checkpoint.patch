+-- Accepted shared revision and its local observation health. Local Task/PR rows
+-- retain pending edits when publication fails; no process authority is shared.
+CREATE TABLE task_record_sync (
+    task_id TEXT PRIMARY KEY REFERENCES tasks(id) ON DELETE CASCADE,
+    revision TEXT,
+    observed_at INTEGER,
+    error TEXT
+);
diff --git a/rust/loopflow/src/task_record.rs b/rust/loopflow/src/task_record.rs
