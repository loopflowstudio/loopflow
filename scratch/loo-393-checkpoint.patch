index 000000000..532517002
--- /dev/null
+++ b/rust/loopflow/src/task_record.rs
@@ -0,0 +1,191 @@
+//! Portable Task facts. Execution, placement and delivery requests never cross Homes.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use crate::durable::TaskId;
+use crate::work::task::{GithubPr, Task, TaskPr, TaskPrId};
+
+pub(crate) const RECORD_URL: &str = "https://loopflow.studio/task-record/";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct TaskRecord {
+    pub task_id: TaskId,
+    pub issue_id: String,
+    pub workspace_slug: String,
+    pub agent: Option<String>,
+    pub prs: Vec<PrRecord>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct PrRecord {
+    pub id: TaskPrId,
+    pub sequence: u32,
+    pub slug: String,
+    pub branch: String,
+    pub base_commit: String,
+    pub parent_pr_id: Option<TaskPrId>,
+    pub github: Option<GithubPr>,
+    pub merge_commit: Option<String>,
+    pub abandoned_at: Option<i64>,
+}
+
+impl TaskRecord {
+    pub fn from_task(task: &Task, prs: &[TaskPr]) -> Self {
+        Self {
+            task_id: task.id.clone(),
+            issue_id: task.plan.id.as_str().to_owned(),
+            workspace_slug: task.workspace_slug.clone(),
+            agent: task.agent.clone(),
+            prs: prs
+                .iter()
+                .map(|pr| PrRecord {
+                    id: pr.id.clone(),
+                    sequence: pr.sequence,
+                    slug: pr.slug.clone(),
+                    branch: pr.branch.clone(),
+                    base_commit: pr.base_commit.clone(),
+                    parent_pr_id: pr.parent_pr_id.clone(),
+                    github: pr.github().cloned(),
+                    merge_commit: pr.merge_commit.clone(),
+                    abandoned_at: pr.abandoned_at.map(|at| at.unix_timestamp()),
+                })
+                .collect(),
+        }
+    }
+}
+
+/// Content-addressed Linear attachment. A predecessor orders edits without
+/// trusting workstation clocks or overwriting a concurrent publisher's bytes.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct TaskRecordRevision {
+    pub parent: Option<String>,
+    pub record: TaskRecord,
+}
+
+impl TaskRecordRevision {
+    pub fn digest(&self) -> String {
+        hex::encode(Sha256::digest(
+            serde_json::to_vec(self).expect("Task record serializes"),
+        ))
+    }
+
+    pub fn url(&self) -> String {
+        format!("{RECORD_URL}{}/{}", self.record.issue_id, self.digest())
+    }
+}
+
+/// Require one complete lineage. Divergent edits remain in Linear for explicit
+/// resolution; neither provider order nor wall-clock time chooses a winner.
+pub(crate) fn latest_revision(
+    issue_id: &str,
+    revisions: &[TaskRecordRevision],
+) -> Result<Option<TaskRecordRevision>, String> {
+    let mut by_id = BTreeMap::new();
+    for revision in revisions {
+        if revision.record.issue_id != issue_id {
+            return Err("Task record belongs to another Linear issue".into());
+        }
+        by_id.insert(revision.digest(), revision);
+    }
+    if by_id.is_empty() {
+        return Ok(None);
+    }
+    let mut tips: BTreeSet<_> = by_id.keys().cloned().collect();
+    for revision in by_id.values() {
+        if let Some(parent) = &revision.parent {
+            let ancestor = by_id
+                .get(parent)
+                .ok_or("Task record history is incomplete; retry Linear refresh")?;
+            if ancestor.record.task_id != revision.record.task_id {
+                return Err("Task record changed its stable Task identity".into());
+            }
+            tips.remove(parent);
+        }
+    }
+    if tips.len() != 1 {
+        return Err("Task records conflict in Linear; preserve local work and resolve the competing revisions before retrying".into());
+    }
+    let tip = tips.first().expect("one tip");
+    let mut visited = BTreeSet::new();
+    let mut cursor = Some(tip.as_str());
+    while let Some(id) = cursor {
+        if !visited.insert(id) {
+            return Err("Task record history contains a cycle".into());
+        }
+        cursor = by_id[id].parent.as_deref();
+    }
+    if visited.len() != by_id.len() {
+        return Err("Task record history is disconnected".into());
+    }
+    Ok(Some((*by_id[tip]).clone()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{latest_revision, TaskRecord, TaskRecordRevision};
+    use crate::durable::TaskId;
+
+    fn original() -> TaskRecordRevision {
+        TaskRecordRevision {
+            parent: None,
+            record: TaskRecord {
+                task_id: TaskId::new(),
+                issue_id: "issue-1".into(),
+                workspace_slug: "remote-development".into(),
+                agent: None,
+                prs: vec![],
+            },
+        }
+    }
+
+    #[test]
+    fn offline_reader_catches_up_despite_duplicates_and_unordered_delivery() {
+        let first = original();
+        let mut next = TaskRecordRevision {
+            parent: Some(first.digest()),
+            record: first.record.clone(),
+        };
+        next.record.agent = Some("claude".into());
+        assert_eq!(
+            latest_revision(
+                "issue-1",
+                &[next.clone(), first.clone(), next.clone(), first]
+            )
+            .unwrap(),
+            Some(next)
+        );
+    }
+
+    #[test]
+    fn concurrent_edits_do_not_silently_choose_a_winner() {
+        let first = original();
+        let mut left = TaskRecordRevision {
+            parent: Some(first.digest()),
+            record: first.record.clone(),
+        };
+        left.record.agent = Some("claude".into());
+        let mut right = left.clone();
+        right.record.agent = Some("codex".into());
+        assert!(latest_revision("issue-1", &[first, left, right])
+            .unwrap_err()
+            .contains("conflict"));
+    }
+
+    #[test]
+    fn missing_history_cannot_be_mistaken_for_a_new_record() {
+        let first = original();
+        let next = TaskRecordRevision {
+            parent: Some(first.digest()),
+            record: first.record,
+        };
+        assert!(latest_revision("issue-1", &[next])
+            .unwrap_err()
+            .contains("incomplete"));
+    }
+}
