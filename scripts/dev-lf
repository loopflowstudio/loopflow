#!/bin/bash
# Build and run lf from the current repo's source tree.
# Usage: scripts/dev-lf [args...]             e.g.  scripts/dev-lf design
#        scripts/dev-lf --isolated-build [args...]  bypass caches in target/isolated
#        source scripts/dev-lf [args...]      applies shell directives like `cd`
#
# Run directly — do NOT use `uv run scripts/dev-lf` (uv mangles args
# and breaks TTY passthrough for interactive agents).

is_sourced() {
    if [[ -n "${ZSH_EVAL_CONTEXT:-}" ]]; then
        [[ "$ZSH_EVAL_CONTEXT" != "toplevel" ]]
    else
        [[ "${BASH_SOURCE[0]}" != "$0" ]]
    fi
}

return_or_exit() {
    local code="$1"
    if is_sourced; then
        return "$code"
    fi
    exit "$code"
}

run_dev_lf() {
    local repo target isolated directive_file status_file exit_code run_status

    repo="$(git rev-parse --show-toplevel)" || return "$?"
    isolated=0
    if [[ "${1:-}" == "--isolated-build" ]]; then
        isolated=1
        shift
    fi
    target="${CARGO_TARGET_DIR:-$repo/target}"
    if [[ "$isolated" -eq 1 ]]; then
        target="$repo/target/isolated"
    fi
    # Cargo resolves relative targets from the invoking directory.
    if [[ "$target" != /* ]]; then
        target="$PWD/$target"
    fi
    directive_file="$(mktemp)"
    status_file="$(mktemp)"

    (
        set -e
        set -o pipefail

        if [[ -z "${RUST_LOG:-}" && ( "${1:-}" == "ps" || "${1:-}" == "top" || "${1:-}" == "prune" ) ]]; then
            export RUST_LOG="lf=info,loopflow=info"
        else
            export RUST_LOG="${RUST_LOG:-lf=debug,loopflow=debug}"
        fi
        export CARGO_TARGET_DIR="$target"
        if [[ "$isolated" -eq 1 ]]; then
            export RUSTC_WRAPPER= RUSTC_WORKSPACE_WRAPPER= SCCACHE_DISABLE=1
        fi
        uv run --project "$repo" python "$repo/scripts/build_cache.py" \
            cargo build -p loopflow --bin lf --manifest-path "$repo/Cargo.toml" </dev/null >&2
        echo "running: $target/debug/lf $*" >&2

        exit_code=0
        LF_BIN="$target/debug/lf" LOOPFLOW_DIRECTIVE_FILE="$directive_file" \
            "$target/debug/lf" "$@" || exit_code=$?
        printf '%s\n' "$exit_code" >"$status_file"
    )
    run_status=$?

    if [[ -s "$status_file" ]]; then
        exit_code="$(cat "$status_file")"
    else
        exit_code="$run_status"
    fi

    if [[ -s "$directive_file" ]]; then
        if is_sourced; then
            source "$directive_file"
            if [[ "$exit_code" -eq 0 ]]; then
                exit_code=$?
            fi
        else
            while IFS= read -r line; do
                echo "$line" >&2
            done <"$directive_file"
            echo "Tip: source scripts/dev-lf ... to apply shell directives in this shell." >&2
        fi
    fi

    rm -f "$directive_file" "$status_file"
    return "$exit_code"
}

run_dev_lf "$@"
return_or_exit $?
