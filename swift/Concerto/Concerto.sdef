<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Concerto Terminology">
    <suite name="Concerto Suite" code="CNRT" description="Concerto scripting commands">
        <command name="capture screenshot" code="CNRTcapt" description="Capture Concerto window screenshot and save to repository">
            <cocoa class="Concerto.CaptureScreenshotCommand"/>
            <direct-parameter type="text" description="Repository path for saving screenshot"/>
            <result type="text" description="Path to saved screenshot"/>
        </command>
    </suite>
</dictionary>
