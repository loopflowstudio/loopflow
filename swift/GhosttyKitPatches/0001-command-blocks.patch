+    /// Return the completed semantic command blocks intersecting the visible
+    /// viewport. Rows are inclusive and relative to the viewport.
+    export fn ghostty_surface_command_blocks(
+        surface: *Surface,
+        blocks: [*]CommandBlock,
+        capacity: usize,
+    ) usize {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        if (!screen.semantic_prompt.seen) return 0;
+        const last_row: u16 = @intCast(screen.pages.rows - 1);
+        const top = screen.pages.pin(.{ .viewport = .{} }) orelse return 0;
+        const selected = screen.selectedCommandBlock();
+
+        // One upward search finds the block the viewport starts inside; the
+        // rest is a single forward walk over the prompts below it.
+        var prior = top.promptIterator(.left_up, null);
+        var prompts = (prior.next() orelse top).promptIterator(.right_down, null);
+        var prompt = prompts.next() orelse return 0;
+        var count: usize = 0;
+        while (count < capacity) {
+            const start_row: u16 = if (screen.pages.pointFromPin(
+                .viewport,
+                prompt,
+            )) |pt| start: {
+                if (pt.viewport.y > last_row) break;
+                break :start @intCast(pt.viewport.y);
+            } else 0;
+
+            // The last prompt is the live one: not a block.
+            const following = prompts.next() orelse break;
+            defer prompt = following;
+            const end_row: u16 = if (screen.pages.pointFromPin(
+                .viewport,
+                following,
+            )) |pt| end: {
+                if (pt.viewport.y == 0) continue;
+                break :end @intCast(@min(pt.viewport.y - 1, last_row));
+            } else continue;
+
+            // A prompt with no input (a bare Enter) is not a command.
+            if (screen.pages.highlightSemanticContent(prompt, .input) == null) continue;
+
+            const row = prompt.rowAndCell().row;
+            blocks[count] = .{
+                .start_row = start_row,
+                .end_row = end_row,
+                .exit_code = if (row.command_exit_known) row.command_exit_code else -1,
+                .selected = if (selected) |block|
+                    block.prompt.node == prompt.node and block.prompt.y == prompt.y
+                else
+                    false,
+            };
+            count += 1;
+        }
+
+        return count;
+    }
+
+    /// Select the completed command block at a viewport row, replacing any
+    /// text selection. Returns false and leaves no block selected when the
+    /// row is the live prompt or outside any block.
+    export fn ghostty_surface_select_command_block(
+        surface: *Surface,
+        viewport_row: u16,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        const selected = selected: {
+            core_surface.renderer_state.mutex.lock();
+            defer core_surface.renderer_state.mutex.unlock();
+
+            const screen = core_surface.renderer_state.terminal.screens.active;
+            const pin = screen.pages.pin(.{ .viewport = .{
+                .x = 0,
+                .y = viewport_row,
+            } }) orelse {
+                screen.clearCommandBlockSelection();
+                break :selected false;
+            };
+            break :selected screen.selectCommandBlock(pin) catch false;
+        };
+
+        // The text selection it replaced must stop being drawn.
+        core_surface.renderer_thread.wakeup.notify() catch {};
+        return selected;
+    }
+
+    /// Read the selected command block's input and output.
+    export fn ghostty_surface_read_selected_command_block(
+        surface: *Surface,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        const block = screen.selectedCommandBlock() orelse return false;
+        return readTextLocked(surface, block.text, result);
+    }
