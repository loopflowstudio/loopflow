+    /// Return the completed semantic command blocks intersecting the visible
+    /// viewport. Rows are inclusive and relative to the viewport.
+    export fn ghostty_surface_command_blocks(
+        surface: *Surface,
+        blocks: [*]CommandBlock,
+        capacity: usize,
+    ) usize {
+        if (capacity == 0) return 0;
+
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        var count: usize = 0;
+        var active_selection: ?terminal.Selection = null;
+        var active_start: u16 = 0;
+
+        for (0..screen.pages.rows) |row| {
+            const pin = screen.pages.pin(.{ .viewport = .{
+                .x = 0,
+                .y = @intCast(row),
+            } }) orelse continue;
+            const selection = screen.selectCommandBlock(pin);
+
+            if (selection) |value| {
+                if (active_selection) |active| {
+                    if (active.eql(value)) continue;
+                    writeCommandBlock(
+                        blocks,
+                        capacity,
+                        &count,
+                        active,
+                        active_start,
+                        @intCast(row - 1),
+                    );
+                }
+                active_selection = value;
+                active_start = @intCast(row);
+            } else if (active_selection != null) {
+                writeCommandBlock(
+                    blocks,
+                    capacity,
+                    &count,
+                    active_selection.?,
+                    active_start,
+                    @intCast(row - 1),
+                );
+                active_selection = null;
+            }
+        }
+
+        if (active_selection != null) {
+            writeCommandBlock(
+                blocks,
+                capacity,
+                &count,
+                active_selection.?,
+                active_start,
+                @intCast(screen.pages.rows - 1),
+            );
+        }
+
+        return count;
     }
 
+    fn writeCommandBlock(
+        blocks: [*]CommandBlock,
+        capacity: usize,
+        count: *usize,
+        selection: terminal.Selection,
+        start_row: u16,
+        end_row: u16,
+    ) void {
+        if (count.* >= capacity) return;
+        const start = selection.start();
+        blocks[count.*] = .{
+            .id = @intFromPtr(start.node) ^
+                (@as(u64, start.y) << 32) ^
+                @as(u64, start.x),
+            .start_row = start_row,
+            .end_row = end_row,
+        };
+        count.* += 1;
+    }
+
+    /// Read a completed semantic command block at a viewport row without
+    /// changing the terminal's ordinary text selection.
+    export fn ghostty_surface_read_command_block(
+        surface: *Surface,
+        viewport_row: u16,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        const pin = screen.pages.pin(.{ .viewport = .{
+            .x = 0,
+            .y = viewport_row,
+        } }) orelse return false;
+        const selection = screen.selectCommandBlock(pin) orelse return false;
+        return readTextLocked(surface, selection, result);
+    }
