+/// A completed shell command: its prompt row and the text of its input and
+/// output. The prompt itself is excluded from the text, but the
+/// prompt-to-prompt row extent is the block an embedder draws.
+pub const CommandBlock = struct {
+    prompt: Pin,
+    text: Selection,
+
+    /// The exit status the shell reported, or null if it reported none.
+    pub fn exitCode(self: CommandBlock) ?u8 {
+        const row = self.prompt.rowAndCell().row;
+        return if (row.command_exit_known) row.command_exit_code else null;
+    }
+};
+
+/// The completed command block containing the pin.
+///
+/// An active command is not a block yet: a following prompt is the proof that
+/// the shell completed it. This keeps clicks in the live composer available to
+/// the shell.
+pub fn commandBlock(self: *const Screen, pin: Pin) ?CommandBlock {
+    if (!self.semantic_prompt.seen) return null;
+
+    var prior_prompts = pin.promptIterator(.left_up, null);
+    const prompt_pin = prior_prompts.next() orelse return null;
+
+    // A following prompt closes this command. Without it, the command is
+    // either still running or is the live input row.
+    var following_prompts = prompt_pin.promptIterator(.right_down, null);
+    _ = following_prompts.next() orelse return null;
+    _ = following_prompts.next() orelse return null;
+
+    const input = self.pages.highlightSemanticContent(
+        prompt_pin,
+        .input,
+    ) orelse return null;
+    const output = self.pages.highlightSemanticContent(
+        prompt_pin,
+        .output,
+    );
+
+    return .{
+        .prompt = prompt_pin,
+        .text = .init(
+            input.start,
+            if (output) |value| value.end else input.end,
+            false,
+        ),
+    };
+}
+
+/// Select the completed command block containing the pin, replacing any text
+/// selection. Returns false, leaving no block selected, when the pin is not
+/// in a completed block.
+pub fn selectCommandBlock(self: *Screen, pin: Pin) Allocator.Error!bool {
+    self.clearCommandBlockSelection();
+    const block = self.commandBlock(pin) orelse return false;
+    self.selected_command = try self.pages.trackPin(block.prompt);
+    self.clearSelection();
+    return true;
+}
+
+pub fn clearCommandBlockSelection(self: *Screen) void {
+    const tracked = self.selected_command orelse return;
+    self.pages.untrackPin(tracked);
+    self.selected_command = null;
+}
+
+/// The selected command block. The selection ends itself when its prompt row
+/// was evicted, erased, or no longer starts a completed command.
+pub fn selectedCommandBlock(self: *Screen) ?CommandBlock {
+    const tracked = self.selected_command orelse return null;
+    if (!tracked.garbage) {
+        if (self.commandBlock(tracked.*)) |block| {
+            if (block.prompt.node == tracked.node and
+                block.prompt.y == tracked.y) return block;
+        }
+    }
+    self.clearCommandBlockSelection();
+    return null;
+}
