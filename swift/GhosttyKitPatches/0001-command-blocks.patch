+test "Screen: selectCommandBlock selects input and output after completion" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 20, .rows = 10, .max_scrollback = 0 });
+    defer s.deinit();
+
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+    s.cursorSetSemanticContent(.{ .input = .clear_explicit });
+    try s.testWriteString("printf alpha\n");
+    s.cursorSetSemanticContent(.output);
+    try s.testWriteString("alpha\nbeta\n");
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+
+    var sel = s.selectCommandBlock(s.pages.pin(.{ .active = .{
+        .x = 0,
+        .y = 2,
+    } }).?).?;
+    defer sel.deinit(&s);
+    const contents = try s.selectionString(alloc, .{
+        .sel = sel,
+        .trim = false,
+    });
+    defer alloc.free(contents);
+    try testing.expectEqualStrings("printf alpha\nalpha\nbeta", contents);
 }
 
