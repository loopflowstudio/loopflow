+// Keep the parsing shell free of startup files. exec -l preserves macOS login
+// shell startup and replaces the parser process, with or without login(1).
+fn loginShellCommand(alloc: Allocator, command: []const u8) Allocator.Error![]const [:0]const u8 {
+    const args = try alloc.alloc([:0]const u8, 5);
+    args[0] = "/bin/bash";
+    args[1] = "--noprofile";
+    args[2] = "--norc";
+    args[3] = "-c";
+    args[4] = try std.fmt.allocPrintSentinel(alloc, "exec -l {s}", .{command}, 0);
+    return args;
+}
