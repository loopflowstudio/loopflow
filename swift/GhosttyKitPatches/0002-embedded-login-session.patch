+
+
+test "execCommand darwin: embedded login shell without login session" {
+    if (comptime !builtin.os.tag.isDarwin()) return error.SkipZigTest;
+    var arena = ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    const result = try execCommand(arena.allocator(), .{ .shell = "/bin/zsh -i" }, false, struct {
+        fn get(_: Allocator) !PasswdEntry {
+            @panic("embedded launch must not consult the account home");
+        }
+    });
+    const expected = [_][]const u8{ "/bin/bash", "--noprofile", "--norc", "-c", "exec -l /bin/zsh -i" };
+    try std.testing.expectEqual(expected.len, result.len);
+    for (expected, result) |want, got| try std.testing.expectEqualStrings(want, got);
+}
+
+test "execCommand darwin: embedded direct command owns argv" {
+    if (comptime !builtin.os.tag.isDarwin()) return error.SkipZigTest;
+    var arena = ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var config_arena = ArenaAllocator.init(std.testing.allocator);
+    const command = try (configpkg.Command{ .direct = &.{ "/bin/cat", "file with spaces" } }).clone(config_arena.allocator());
+    const result = try execCommand(arena.allocator(), command, false, struct {
+        fn get(_: Allocator) !PasswdEntry {
+            @panic("embedded launch must not consult the account home");
+        }
+    });
+    config_arena.deinit();
+    try std.testing.expectEqual(2, result.len);
+    try std.testing.expectEqualStrings("/bin/cat", result[0]);
+    try std.testing.expectEqualStrings("file with spaces", result[1]);
+}
