diff --git a/src/apprt/program_status.zig b/src/apprt/program_status.zig
--- /dev/null
+++ b/src/apprt/program_status.zig
@@ -0,0 +1,118 @@
+//! Owned bridge from validated terminal reports to the embedded action callback.
+//! No record storage, parsing, or process authority lives here.
+const std = @import("std");
+const terminal = @import("../terminal/main.zig");
+const lib = @import("../lib/main.zig");
+const ProgramStatus = @This();
+
+pub const Action = struct {
+    value: *const ProgramStatus.C,
+    pub const C = *const ProgramStatus.C;
+    pub fn cval(self: Action) Action.C {
+        return self.value;
+    }
+};
+
+pub const Event = enum(c_int) { report, prompt, reset, exit };
+
+// Callback-lifetime pointers; null optional strings mean absent, id="" is root.
+pub const C = extern struct {
+    event: Event,
+    state: c_int,
+    kind: c_int,
+    progress: i16,
+    id: [*:0]const u8,
+    app: ?[*:0]const u8,
+    title: ?[*:0]const u8,
+    msg: ?[*:0]const u8,
+};
+
+event: Event,
+state: c_int = -1,
+kind: c_int = -1,
+progress: i16 = -1,
+id: [128:0]u8 = @splat(0),
+app: [32:0]u8 = @splat(0),
+title: [192:0]u8 = @splat(0),
+msg: [2048:0]u8 = @splat(0),
+has_app: bool = false,
+has_title: bool = false,
+has_msg: bool = false,
+
+pub fn init(report: terminal.osc.Command.ProgramStatus.Report) !ProgramStatus {
+    var result: ProgramStatus = .{ .event = .report, .state = @intFromEnum(report.state) };
+    if (report.readOption(.kind)) |kind| result.kind = @intFromEnum(kind);
+    if (report.readOption(.progress)) |progress| result.progress = progress;
+    if (report.readOption(.id)) |id| @memcpy(result.id[0..id.len], id);
+    if (report.readOption(.app)) |app| {
+        @memcpy(result.app[0..app.len], app);
+        result.has_app = true;
+    }
+    if (report.readOption(.title) != null) {
+        var writer: std.Io.Writer = .fixed(result.title[0..192]);
+        try report.writeText(.title, &writer);
+        result.has_title = true;
+    }
+    if (report.readOption(.msg) != null) {
+        var writer: std.Io.Writer = .fixed(result.msg[0..2048]);
+        try report.writeText(.msg, &writer);
+        result.has_msg = true;
+    }
+    return result;
+}
+
+pub fn cval(self: *const ProgramStatus) C {
+    return .{
+        .event = self.event,
+        .state = self.state,
+        .kind = self.kind,
+        .progress = self.progress,
+        .id = &self.id,
+        .app = if (self.has_app) &self.app else null,
+        .title = if (self.has_title) &self.title else null,
+        .msg = if (self.has_msg) &self.msg else null,
+    };
+}
+
+test "program status embedded owns decoded payload through parser reuse" {
+    var parser: terminal.osc.Parser = .init(std.testing.allocator);
+    defer parser.deinit();
+    parser.nextSlice("7501;state=blocked:kind=question:id=lf/job:app=fixture:progress=25:msg=PG9rPj8=:title=QnVpbGQ=");
+    const command = parser.end(0x07).?;
+    var owned = try init(command.program_status.report);
+    parser.reset();
+    parser.nextSlice("7501;state=working:id=other");
+    _ = parser.end(0x07);
+    const c = owned.cval();
+    const action: @import("action.zig").Action = .{ .program_status = .{ .value = &c } };
+    const wire = action.cval();
+    try std.testing.expectEqual(@import("action.zig").Action.Key.program_status, wire.key);
+    try std.testing.expect(wire.value.program_status == &c);
+    try std.testing.expectEqual(@sizeOf(@import("ghostty.h").ghostty_action_program_status_s), @sizeOf(C));
+    try std.testing.expectEqual(@as(c_int, 3), c.state);
+    try std.testing.expectEqual(@as(c_int, 1), c.kind);
+    try std.testing.expectEqual(@as(i16, 25), c.progress);
+    try std.testing.expectEqualStrings("lf/job", std.mem.span(c.id));
+    try std.testing.expectEqualStrings("fixture", std.mem.span(c.app.?));
+    try std.testing.expectEqualStrings("<ok>?", std.mem.span(c.msg.?));
+    try std.testing.expectEqualStrings("Build", std.mem.span(c.title.?));
+}
+
+test "program status embedded omitted values and boundary ABI" {
+    var parser: terminal.osc.Parser = .init(std.testing.allocator);
+    defer parser.deinit();
+    parser.nextSlice("7501;state=clear");
+    var owned = try init(parser.end(0x07).?.program_status.report);
+    const c = owned.cval();
+    try std.testing.expectEqualStrings("", std.mem.span(c.id));
+    try std.testing.expectEqual(@as(c_int, 5), c.state);
+    try std.testing.expectEqual(@as(c_int, -1), c.kind);
+    try std.testing.expectEqual(@as(i16, -1), c.progress);
+    try std.testing.expect(c.app == null and c.title == null and c.msg == null);
+    try lib.checkGhosttyHEnum(Event, "GHOSTTY_PROGRAM_STATUS_");
+    inline for (.{ Event.prompt, Event.reset, Event.exit }) |event| {
+        const boundary: ProgramStatus = .{ .event = event };
+        try std.testing.expectEqual(event, boundary.cval().event);
+        try std.testing.expectEqual(@as(c_int, -1), boundary.cval().state);
+    }
+}
