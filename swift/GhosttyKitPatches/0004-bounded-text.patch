+/// Format directly into caller-owned storage. No allocation, pin map, or full
+/// intermediate string; a full destination stops the existing formatter.
+pub fn selectionStringBounded(
+    self: *const Screen,
+    opts: SelectionString,
+    destination: []u8,
+) struct { len: usize, truncated: bool } {
+    var writer: std.Io.Writer = .fixed(destination);
+    var formatter: ScreenFormatter = .init(self, .{
+        .emit = .plain,
+        .unwrap = true,
+        .trim = opts.trim,
+    });
+    formatter.content = .{ .selection = opts.sel };
+    const truncated = if (formatter.format(&writer)) |_| false else |_| true;
+    // The formatter emits valid UTF-8; only the final scalar can be partial.
+    // Inspect at most four bytes, not the entire extracted prefix.
+    var len = writer.end;
+    if (truncated and len > 0) {
+        var start = len - 1;
+        while (start > 0 and destination[start] & 0xc0 == 0x80) : (start -= 1) {}
+        if (!std.unicode.utf8ValidateSlice(destination[start..len])) len = start;
+    }
+    return .{ .len = len, .truncated = truncated };
+}
