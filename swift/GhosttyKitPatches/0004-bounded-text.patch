+test "Screen: bounded text reads selected blocks without cleanup" {
+    const testing = std.testing;
+    var s = try init(testing.io, testing.allocator, .{ .cols = 20, .rows = 10 });
+    defer s.deinit();
+    try testWriteCommand(&s, "echo hi", "hi\n");
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+    try testing.expect(try s.selectCommandBlock(s.pages.getTopLeft(.active)));
+    const pin = s.selected_command.?;
+    var buffer: [64]u8 = undefined;
+    const result = s.selectionStringBounded(.{ .sel = s.selectedCommandBlock().?.text, .trim = false }, &buffer);
+    try testing.expectEqualStrings("echo hi\nhi", buffer[0..result.len]);
+    try testing.expect(!result.truncated);
+    try testing.expect(s.selected_command.? == pin);
+    // Invalidate the prompt without asking the reader to release its pin.
+    pin.garbage = true;
+    try testing.expect(s.selectedCommandBlock() == null);
+    try testing.expect(s.selected_command.? == pin);
+}
