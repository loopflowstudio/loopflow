+    /// NULL selection means the current user selection (empty is successful).
+    /// Caller owns the bounded destination; this path never allocates text.
+    export fn ghostty_surface_read_text_bounded(
+        surface: *Surface,
+        sel: ?*const Selection,
+        destination: [*]u8,
+        capacity: usize,
+        written: *usize,
+        truncated: *bool,
+    ) bool {
+        written.* = 0;
+        truncated.* = false;
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+        const screen = core_surface.renderer_state.terminal.screens.active;
+        const core_sel = if (sel) |value|
+            value.core(screen) orelse return false
+        else
+            screen.selection orelse if (screen.selectedCommandBlock()) |block| block.text else return true;
+        const result = screen.selectionStringBounded(.{
+            .sel = core_sel,
+            .trim = false,
+        }, destination[0..capacity]);
+        written.* = result.len;
+        truncated.* = result.truncated;
+        return true;
+    }
