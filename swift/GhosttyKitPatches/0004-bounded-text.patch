+
+test "Screen: bounded text matches complete text at every byte limit" {
+    const testing = std.testing;
+    // Empty, all scalar widths, combining characters, and soft-wrapped text.
+    for ([_][]const u8{ "", "ascii", "aé界😀z", "e\u{301}", "wrapped text crosses rows" }) |text| {
+        var s = try init(testing.io, testing.allocator, .{ .cols = 10, .rows = 5 });
+        defer s.deinit();
+        try s.testWriteString(text);
+        const opts: SelectionString = .{
+            .sel = .init(s.pages.getTopLeft(.screen), s.pages.getBottomRight(.screen).?, false),
+            .trim = false,
+        };
+        const full = try s.selectionString(testing.allocator, opts);
+        defer testing.allocator.free(full);
+        try testing.expectEqualStrings(text, full);
+        var buffer: [64]u8 = undefined;
+        for (0..full.len + 2) |capacity| {
+            @memset(&buffer, 0xaa);
+            const result = s.selectionStringBounded(opts, buffer[0..capacity]);
+            var expected = @min(capacity, full.len);
+            while (!std.unicode.utf8ValidateSlice(full[0..expected])) : (expected -= 1) {}
+            try testing.expectEqualStrings(full[0..expected], buffer[0..result.len]);
+            try testing.expectEqual(capacity < full.len, result.truncated);
+            for (buffer[capacity..]) |byte| try testing.expectEqual(@as(u8, 0xaa), byte);
+        }
+    }
+}
+
+test "Screen: bounded text limits scrollback without allocation or selection changes" {
+    const testing = std.testing;
+    var allocator: testing.FailingAllocator = .init(testing.allocator, .{});
+    var s = try init(testing.io, allocator.allocator(), .{ .cols = 80, .rows = 5 });
+    defer s.deinit();
+    for (0..1000) |_| try s.testWriteString("retained output\n");
+    const sel: Selection = .init(s.pages.getTopLeft(.screen), s.pages.getBottomRight(.screen).?, false);
+    try s.select(sel);
+    allocator.fail_index = allocator.alloc_index;
+    allocator.resize_fail_index = allocator.resize_index;
+    const allocated = allocator.allocated_bytes;
+    const freed = allocator.freed_bytes;
+    var buffer: [32]u8 = undefined;
+    const result = s.selectionStringBounded(.{ .sel = sel, .trim = false }, &buffer);
+    try testing.expect(result.truncated);
+    try testing.expectEqual(buffer.len, result.len);
+    try testing.expect(std.mem.startsWith(u8, &buffer, "retained output"));
+    try testing.expect(s.selection.?.eql(sel));
+    try testing.expect(!allocator.has_induced_failure);
+    try testing.expectEqual(allocated, allocator.allocated_bytes);
+    try testing.expectEqual(freed, allocator.freed_bytes);
+}
+
+test "Screen: bounded text reads selected blocks without cleanup" {
+    const testing = std.testing;
+    var s = try init(testing.io, testing.allocator, .{ .cols = 20, .rows = 10 });
+    defer s.deinit();
+    try testWriteCommand(&s, "echo hi", "hi\n");
+    s.cursorSetSemanticContent(.{ .prompt = .initial });
+    try s.testWriteString("$ ");
+    try testing.expect(try s.selectCommandBlock(s.pages.getTopLeft(.active)));
+    const pin = s.selected_command.?;
+    var buffer: [64]u8 = undefined;
+    const result = s.selectionStringBounded(.{ .sel = s.selectedCommandBlock().?.text, .trim = false }, &buffer);
+    try testing.expectEqualStrings("echo hi\nhi", buffer[0..result.len]);
+    try testing.expect(!result.truncated);
+    try testing.expect(s.selected_command.? == pin);
+    // Invalidate the prompt without asking the reader to release its pin.
+    pin.garbage = true;
+    try testing.expect(s.selectedCommandBlock() == null);
+    try testing.expect(s.selected_command.? == pin);
+}
