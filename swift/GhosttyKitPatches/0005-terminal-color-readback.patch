+
+test "c_get: terminal colors" {
+    const testing = std.testing;
+    var config = try Config.default(testing.allocator);
+    defer config.deinit();
+
+    inline for (.{
+        "cursor-color",               "cursor-text",
+        "selection-background",       "selection-foreground",
+        "search-background",          "search-foreground",
+        "search-selected-background", "search-selected-foreground",
+    }) |name| {
+        @field(config, name) = .{ .color = .{ .r = 0x12, .g = 0x34, .b = 0x56 } };
+        var color: Color.C = undefined;
+        try testing.expect(get(&config, @field(Key, name), &color));
+        try testing.expectEqualDeep(Color.C{ .r = 0x12, .g = 0x34, .b = 0x56 }, color);
+    }
+}
+
+test "c_get: unresolved terminal colors leave output unchanged" {
+    const testing = std.testing;
+    var config = try Config.default(testing.allocator);
+    defer config.deinit();
+
+    const sentinel = Color.C{ .r = 0xAB, .g = 0xCD, .b = 0xEF };
+    var color = sentinel;
+    for ([_]?Config.TerminalColor{ null, .@"cell-foreground", .@"cell-background" }) |value| {
+        config.@"cursor-color" = value;
+        try testing.expect(!get(&config, .@"cursor-color", &color));
+        try testing.expectEqualDeep(sentinel, color);
+    }
+}
