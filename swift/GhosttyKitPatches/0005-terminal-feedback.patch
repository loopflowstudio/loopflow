diff --git a/src/renderer/Feedback.zig b/src/renderer/Feedback.zig
new file mode 100644
index 0000000..9160ad9
--- /dev/null
+++ b/src/renderer/Feedback.zig
@@ -0,0 +1,158 @@
+//! Surface-local copy receipt and Find cue lifetime. No text or tracked pins.
+const Feedback = @This();
+const std = @import("std");
+const terminal = @import("../terminal/main.zig");
+
+receipt: u64 = 0,
+screen_id: usize = 0,
+revision: u64 = 0,
+viewport_node: usize = 0,
+viewport_y: usize = 0,
+viewport_serial: u64 = 0,
+cols: usize = 0,
+rows: usize = 0,
+started: ?std.Io.Timestamp = null,
+visible: bool = true,
+reduce_motion: bool = false,
+
+pub fn issue(self: *Feedback, screen: *const terminal.Screen) u64 {
+    self.cancel();
+    self.bind(screen);
+    return self.receipt;
+}
+
+pub fn bind(self: *Feedback, screen: *const terminal.Screen) void {
+    const top = screen.pages.pin(.{ .viewport = .{} }) orelse return;
+    self.screen_id = @intFromPtr(screen);
+    self.revision = screen.selection_revision;
+    self.viewport_node = @intFromPtr(top.node);
+    self.viewport_y = top.y;
+    self.viewport_serial = top.node.serial;
+    self.cols = screen.pages.cols;
+    self.rows = screen.pages.rows;
+}
+
+pub fn valid(self: *const Feedback, screen: *const terminal.Screen) bool {
+    if (!self.visible or self.screen_id != @intFromPtr(screen) or self.revision != screen.selection_revision or
+        self.cols != screen.pages.cols or self.rows != screen.pages.rows) return false;
+    const top = screen.pages.pin(.{ .viewport = .{} }) orelse return false;
+    return self.viewport_node == @intFromPtr(top.node) and self.viewport_y == top.y and self.viewport_serial == top.node.serial;
+}
+
+/// A successful copy acknowledges the selection without scheduling cell emphasis.
+pub fn confirm(self: *const Feedback, receipt: u64, screen: *const terminal.Screen) bool {
+    return receipt != 0 and receipt == self.receipt and self.valid(screen);
+}
+
+pub fn cancel(self: *Feedback) void {
+    self.started = null;
+    self.screen_id = 0;
+    self.receipt +%= 1;
+    if (self.receipt == 0) self.receipt = 1;
+}
+
+pub fn remaining(self: *const Feedback, now: std.Io.Timestamp) u64 {
+    const start = self.started orelse return 0;
+    const elapsed = @max(0, @divTrunc(start.durationTo(now).nanoseconds, std.time.ns_per_ms));
+    return 160 -| @as(u64, @intCast(elapsed));
+}
+
+/// Recompute the absolute expiry on every draw, including unrelated shader draws.
+/// A painted cue needs one final update to clear its cells after expiry.
+pub fn wakeDelay(self: *const Feedback, now: std.Io.Timestamp, painted: u8, interval: u64) ?u64 {
+    const left = self.remaining(now);
+    if (left == 0 and painted == 0) return null;
+    return if (self.reduce_motion) @max(left, interval) else interval;
+}
+
+pub fn opacity(self: *const Feedback, now: std.Io.Timestamp) u8 {
+    const left = self.remaining(now);
+    if (left == 0) return 0;
+    if (self.reduce_motion) return 180;
+    const fraction = @as(f32, @floatFromInt(left)) / 160;
+    return @intFromFloat(180 * fraction * fraction);
+}
+
+test "terminal feedback copy receipts reject selection replacement" {
+    const testing = std.testing;
+    var screen = try terminal.Screen.init(testing.io, testing.allocator, .{ .cols = 10, .rows = 3 });
+    defer screen.deinit();
+    const start = screen.pages.pin(.{ .active = .{} }).?;
+    const end = screen.pages.pin(.{ .active = .{ .x = 3, .y = 1 } }).?;
+    try screen.select(.init(start, end, false));
+    var cue: Feedback = .{};
+    const receipt = cue.issue(&screen);
+    const now: std.Io.Timestamp = .now(testing.io, .awake);
+    try testing.expect(cue.confirm(receipt, &screen));
+    try testing.expectEqual(@as(u8, 0), cue.opacity(now));
+    try testing.expect(cue.wakeDelay(now, 0, 8) == null);
+    screen.clearSelection();
+    try testing.expect(!cue.confirm(receipt, &screen));
+    cue.cancel();
+    try testing.expectEqual(@as(u64, 0), cue.remaining(now));
+}
+
+test "terminal feedback Find finite expiry and reduced motion" {
+    const testing = std.testing;
+    const start: std.Io.Timestamp = .zero;
+    const midway = start.addDuration(.fromMilliseconds(80));
+    const end = start.addDuration(.fromMilliseconds(160));
+    var cue: Feedback = .{ .started = start };
+    try testing.expectEqual(@as(u8, 180), cue.opacity(start));
+    try testing.expect(cue.opacity(midway) < cue.opacity(start));
+    cue.reduce_motion = true;
+    try testing.expectEqual(@as(u8, 180), cue.opacity(midway));
+    try testing.expectEqual(@as(u8, 0), cue.opacity(end));
+    try testing.expectEqual(@as(u64, 0), cue.remaining(end));
+    cue.started = midway;
+    try testing.expectEqual(@as(u64, 80), cue.remaining(end));
+    cue.cancel();
+    try testing.expectEqual(@as(u8, 0), cue.opacity(end));
+}
+
+test "terminal feedback reset and geometry invalidate receipts" {
+    const testing = std.testing;
+    var screen = try terminal.Screen.init(testing.io, testing.allocator, .{ .cols = 10, .rows = 3 });
+    defer screen.deinit();
+    const pin = screen.pages.pin(.{ .active = .{} }).?;
+    try screen.select(.init(pin, pin, false));
+    var cue: Feedback = .{};
+    const receipt = cue.issue(&screen);
+    try screen.resize(.{ .cols = 5, .rows = 3, .reflow = true });
+    try testing.expect(!cue.confirm(receipt, &screen));
+    try screen.resize(.{ .cols = 10, .rows = 3, .reflow = true });
+    try testing.expect(!cue.confirm(receipt, &screen));
+    screen.reset();
+    try testing.expect(!cue.confirm(receipt, &screen));
+}
+
+test "terminal feedback copy preserves wrapped wide and combining text" {
+    const testing = std.testing;
+    var screen = try terminal.Screen.init(testing.io, testing.allocator, .{ .cols = 7, .rows = 6 });
+    defer screen.deinit();
+    try screen.testWriteString("error 界 e\u{301} wrapped text");
+    const selection: terminal.Selection = .init(screen.pages.getTopLeft(.screen), screen.pages.getBottomRight(.screen).?, false);
+    try screen.select(selection);
+    const before = try screen.selectionString(testing.allocator, .{ .sel = screen.selection.?, .trim = false });
+    defer testing.allocator.free(before);
+    var cue: Feedback = .{};
+    const receipt = cue.issue(&screen);
+    try testing.expect(cue.confirm(receipt, &screen));
+    const after = try screen.selectionString(testing.allocator, .{ .sel = screen.selection.?, .trim = false });
+    defer testing.allocator.free(after);
+    try testing.expectEqualStrings("error 界 e\u{301} wrapped text", before);
+    try testing.expectEqualStrings(before, after);
+}
+
+test "terminal feedback redraws cannot postpone static cue expiry" {
+    const testing = std.testing;
+    var cue: Feedback = .{ .started = .zero, .reduce_motion = true };
+    for (0..21) |tick| {
+        const now = std.Io.Timestamp.zero.addDuration(.fromMilliseconds(@intCast(tick * 8)));
+        try testing.expectEqual(@max(@as(u64, 160) -| tick * 8, 8), cue.wakeDelay(now, 180, 8).?);
+    }
+    const expired = std.Io.Timestamp.zero.addDuration(.fromMilliseconds(168));
+    try testing.expect(cue.wakeDelay(expired, 0, 8) == null);
+    cue.cancel();
+    try testing.expect(cue.wakeDelay(.zero, 0, 8) == null);
+}
