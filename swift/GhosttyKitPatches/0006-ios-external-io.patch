diff --git a/src/termio/External.zig b/src/termio/External.zig
--- /dev/null
+++ b/src/termio/External.zig
@@ -0,0 +1,160 @@
+//! External leaves the pty to the embedder. No command starts: the embedder
+//! feeds the bytes it read with `Termio.processOutput` and receives every byte
+//! the terminal would write (keys, pastes, query replies) through `write`.
+const External = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+/// Called on the IO thread. The bytes are only valid for the call.
+pub const Write = *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void;
+
+pub const Config = struct {
+    write: Write,
+    userdata: ?*anyopaque,
+};
+
+config: Config,
+
+pub fn init(cfg: Config) External {
+    return .{ .config = cfg };
+}
+
+pub fn deinit(self: *External) void {
+    _ = self;
+}
+
+pub fn initTerminal(self: *External, term: *terminal.Terminal) void {
+    _ = self;
+    _ = term;
+}
+
+pub fn threadEnter(
+    self: *External,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+    td.backend = .{ .external = .{} };
+}
+
+pub fn threadExit(self: *External, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn focusGained(
+    self: *External,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+/// The embedder set the size, so it already knows it.
+pub fn resize(
+    self: *External,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    _ = self;
+    _ = grid_size;
+    _ = screen_size;
+}
+
+pub fn queueWrite(
+    self: *External,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+    if (!linefeed) {
+        if (data.len > 0) self.config.write(self.config.userdata, data.ptr, data.len);
+        return;
+    }
+
+    // Linefeed mode sends CR as CRLF.
+    var buf: [256]u8 = undefined;
+    var len: usize = 0;
+    for (data) |byte| {
+        if (len + 2 > buf.len) {
+            self.config.write(self.config.userdata, &buf, len);
+            len = 0;
+        }
+        buf[len] = byte;
+        len += 1;
+        if (byte == '\r') {
+            buf[len] = '\n';
+            len += 1;
+        }
+    }
+    if (len > 0) self.config.write(self.config.userdata, &buf, len);
+}
+
+pub fn childExitedAbnormally(
+    self: *External,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+pub fn getProcessInfo(self: *External, comptime info: ProcessInfo) ?ProcessInfo.Type(info) {
+    _ = self;
+    return null;
+}
+
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
+
+const TestSink = struct {
+    bytes: [1024]u8 = undefined,
+    len: usize = 0,
+    calls: usize = 0,
+
+    fn write(ud: ?*anyopaque, ptr: [*]const u8, len: usize) callconv(.c) void {
+        const self: *TestSink = @ptrCast(@alignCast(ud.?));
+        @memcpy(self.bytes[self.len..][0..len], ptr[0..len]);
+        self.len += len;
+        self.calls += 1;
+    }
+};
+
+test "external io: writes reach the embedder whole" {
+    var sink: TestSink = .{};
+    var io: External = .init(.{ .write = TestSink.write, .userdata = &sink });
+    try io.queueWrite(std.testing.allocator, undefined, "\x1b[200~two\nlines\x1b[201~", false);
+    try io.queueWrite(std.testing.allocator, undefined, "", false);
+    try std.testing.expectEqualStrings("\x1b[200~two\nlines\x1b[201~", sink.bytes[0..sink.len]);
+    try std.testing.expectEqual(1, sink.calls);
+}
+
+test "external io: linefeed mode sends CR as CRLF across chunks" {
+    var sink: TestSink = .{};
+    var io: External = .init(.{ .write = TestSink.write, .userdata = &sink });
+    try io.queueWrite(std.testing.allocator, undefined, "a\r" ** 200, true);
+    try std.testing.expectEqualStrings("a\r\n" ** 200, sink.bytes[0..sink.len]);
+    try std.testing.expect(sink.calls > 1);
+}
