#!/bin/bash
# Development commands for Concerto (Swift app)

set -e

DEV_APP="$HOME/Applications/Concerto Dev.app"

usage() {
    echo "Usage: ./dev <command>"
    echo ""
    echo "Commands:"
    echo "  build      Build the app"
    echo "  test       Build and run tests"
    echo "  ui-test    Generate Xcode project and run UI tests"
    echo "  run        Build and launch the app (installs to ~/Applications)"
    echo "  run-debug  Build and run with stdout visible (for debugging)"
    echo "  logs       Tail the app logs"
    echo "  clean      Remove dev app and reset permissions"
    echo "  xcode      Open in Xcode"
    echo "  release    Build release .app and .dmg"
    echo "  help       Show this message"
}

cd "$(dirname "$0")"

case "${1:-help}" in
    build)
        echo "Building Concerto..."
        swift build
        ;;
    test)
        echo "Building and testing..."
        swift build
        swift test
        ;;
    ui-test)
        echo "Generating Xcode project..."
        if ! command -v xcodegen >/dev/null 2>&1; then
            echo "xcodegen not found. Install with: brew install xcodegen"
            exit 1
        fi
        rm -rf LoopflowSwift.xcodeproj
        xcodegen generate
        echo "Running UI tests..."
        DERIVED_DATA="${TMPDIR:-/tmp}/concerto-ui-tests"
        rm -rf "$DERIVED_DATA"
        xcodebuild test -project LoopflowSwift.xcodeproj -scheme Concerto -destination 'platform=macOS,arch=arm64' -derivedDataPath "$DERIVED_DATA"
        ;;
    run)
        echo "Building and running Concerto..."
        swift build

        # Install to stable location to preserve macOS permissions across rebuilds.
        # TCC ties permissions to app bundle path - using a fixed path means you only
        # grant Accessibility/Automation permissions once.
        APP_DIR="$DEV_APP/Contents"
        mkdir -p "$APP_DIR/MacOS"
        mkdir -p "$APP_DIR/Resources"
        cp .build/debug/Concerto "$APP_DIR/MacOS/"
        cp Concerto/Info.plist "$APP_DIR/"
        cp Concerto/Concerto.sdef "$APP_DIR/Resources/"
        cp Concerto/AppIcon.icns "$APP_DIR/Resources/"

        # Ad-hoc sign the app bundle (required for macOS to run it)
        codesign --force --deep --sign - "$DEV_APP"

        # Launch from stable location
        open "$DEV_APP"
        ;;
    run-debug)
        echo "Building and running Concerto (debug mode with logs)..."
        swift build

        APP_DIR="$DEV_APP/Contents"
        mkdir -p "$APP_DIR/MacOS"
        mkdir -p "$APP_DIR/Resources"
        cp .build/debug/Concerto "$APP_DIR/MacOS/"
        cp Concerto/Info.plist "$APP_DIR/"
        cp Concerto/Concerto.sdef "$APP_DIR/Resources/"
        cp Concerto/AppIcon.icns "$APP_DIR/Resources/"

        codesign --force --deep --sign - "$DEV_APP"

        # Run directly (not via open) so stdout/stderr go to terminal
        echo "Logs: ~/Library/Logs/Concerto/"
        echo "Press Ctrl+C to quit"
        echo "---"
        "$DEV_APP/Contents/MacOS/Concerto"
        ;;
    logs)
        LOG_DIR="$HOME/Library/Logs/Concerto"
        if [ -d "$LOG_DIR" ]; then
            tail -f "$LOG_DIR"/*.log
        else
            echo "No logs yet. Run the app first."
        fi
        ;;
    clean)
        echo "Removing dev app..."
        rm -rf "$DEV_APP"
        echo "Resetting Accessibility permissions..."
        tccutil reset Accessibility com.loopflow.concerto 2>/dev/null || true
        echo "Resetting Automation permissions..."
        tccutil reset AppleEvents com.loopflow.concerto 2>/dev/null || true
        echo "Done. Next ./dev run will require re-granting permissions."
        ;;
    xcode)
        echo "Opening in Xcode..."
        open LoopflowSwift.xcodeproj
        ;;
    release)
        echo "Building Concerto release..."

        # Build release
        swift build -c release

        # Create .app bundle
        APP_NAME="Loopflow Concerto"
        APP_DIR="dist/$APP_NAME.app/Contents"
        rm -rf dist
        mkdir -p "$APP_DIR/MacOS"
        mkdir -p "$APP_DIR/Resources"

        # Copy binary, Info.plist, sdef, and icon
        cp .build/release/Concerto "$APP_DIR/MacOS/"
        cp Concerto/Info.plist "$APP_DIR/"
        cp Concerto/Concerto.sdef "$APP_DIR/Resources/"
        cp Concerto/AppIcon.icns "$APP_DIR/Resources/"

        # Create PkgInfo
        echo -n "APPL????" > "$APP_DIR/PkgInfo"

        echo "Created dist/$APP_NAME.app"

        # Create DMG
        DMG_NAME="LoopflowConcerto"
        DMG_PATH="dist/$DMG_NAME.dmg"
        rm -f "$DMG_PATH"

        # Create temporary DMG directory
        DMG_TMP="dist/dmg_tmp"
        rm -rf "$DMG_TMP"
        mkdir -p "$DMG_TMP"
        cp -r "dist/$APP_NAME.app" "$DMG_TMP/"

        # Create symlink to Applications
        ln -s /Applications "$DMG_TMP/Applications"

        # Create DMG
        hdiutil create -volname "$APP_NAME" -srcfolder "$DMG_TMP" -ov -format UDZO "$DMG_PATH"

        # Cleanup
        rm -rf "$DMG_TMP"

        echo ""
        echo "Release built:"
        echo "  App: dist/$APP_NAME.app"
        echo "  DMG: $DMG_PATH"
        echo ""
        echo "To install: open $DMG_PATH and drag to Applications"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        echo ""
        usage
        exit 1
        ;;
esac
