{
  "cases": [
    {
      "name": "dependency_order_and_body",
      "drafts": [
        {
          "filename": "a_backfill.sql",
          "text": "-- depends_on: z_setup\nINSERT INTO example (id) VALUES ('seed');\n"
        },
        {
          "filename": "b_independent.sql",
          "text": "-- depends_on: none\nALTER TABLE example ADD COLUMN note TEXT;\n"
        },
        {
          "filename": "z_setup.sql",
          "text": "-- depends_on:\nCREATE TABLE example (\n    id TEXT PRIMARY KEY\n);\n"
        }
      ],
      "expected": [
        {
          "name": "b_independent",
          "dependencies": [],
          "sql": "ALTER TABLE example ADD COLUMN note TEXT;\n"
        },
        {
          "name": "z_setup",
          "dependencies": [],
          "sql": "CREATE TABLE example (\n    id TEXT PRIMARY KEY\n);\n"
        },
        {
          "name": "a_backfill",
          "dependencies": [
            "z_setup"
          ],
          "sql": "INSERT INTO example (id) VALUES ('seed');\n"
        }
      ],
      "error": null
    },
    {
      "name": "released_dependency",
      "released": [
        {
          "filename": "0.12.8.001_released.sql",
          "text": "-- draft: released_foundation\nSELECT 1;\n"
        }
      ],
      "drafts": [
        {
          "filename": "local_after_released.sql",
          "text": "-- depends_on: released_foundation\nCREATE TABLE local_after_released (id TEXT PRIMARY KEY);\n"
        }
      ],
      "expected": [
        {
          "name": "local_after_released",
          "dependencies": [
            "released_foundation"
          ],
          "sql": "CREATE TABLE local_after_released (id TEXT PRIMARY KEY);\n"
        }
      ],
      "error": null
    },
    {
